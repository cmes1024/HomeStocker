    "write": false
  },
  "memberships": {
    "read": "doc.openid == auth.openid",
    "write": false
  },
  "items": {
    "read": false,
    "write": false
  },
  "spaces": {
    "read": false,
    "write": false
  },
  "locations": {
    "read": false,
    "write": false
  }
}
