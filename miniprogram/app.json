{
  "pages": [
    "pages/onboarding/index",
    "pages/items/index",
    "pages/items/edit",
    "pages/family/index",
    "pages/family/tags",
    "pages/family/messages"
  ],
  "subpackages": [
    {
      "root": "packageBrowse",
      "name": "browse",
      "pages": [
        "spaces/index",
        "spaces/detail",
        "items/detail",
        "pockets/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/family/index": {
      "network": "wifi",
      "packages": ["browse"]
    }
  },
  "usingComponents": {
    "AppShell": "/components/AppShell/index",
    "ThemeRadialBg": "/components/ThemeRadialBg/index",
    "ThemeProvider": "/components/ThemeProvider/index",
    "loading": "/components/loading/index",
    "mask-element": "/components/maskElement/index"
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家庭物资",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationStyle": "custom"
  },
  "style": "v2",
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "workers": "workers",
  "useExtendedLib": {
    "weui": true
  }
}
