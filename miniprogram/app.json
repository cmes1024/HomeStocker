{
  "pages": [
    "pages/items/index",
    "pages/onboarding/index",
    "pages/items/edit",
    "pages/family/index",
    "pages/family/tags",
    "pages/family/messages"
  ],
  "subpackages": [
    {
      "root": "packageBrowse",
      "name": "browse",
      "pages": [
        "spaces/index",
        "spaces/detail",
        "items/detail",
        "pockets/index"
      ]
    },
    {
      "root": "packageAi",
      "name": "ai",
      "pages": [
        "keys/index"
      ]
    },
    {
      "root": "packageAiAssist",
      "name": "aiAssist",
      "pages": [
        "assist/index"
      ]
    },
    {
      "root": "packageDemo",
      "name": "demo",
      "pages": [
        "demo/index/index",
        "demo/overlay/index",
        "demo/request/index",
        "demo/system/index",
        "demo/worker/index",
        "demo/page-router/index",
        "index/index",
        "chat/chat"
      ]
    }
  ],
  "preloadRule": {
    "pages/items/index": {
      "network": "all",
      "packages": ["browse"]
    },
    "pages/family/index": {
      "network": "wifi",
      "packages": ["browse", "aiAssist"]
    }
  },
  "usingComponents": {
    "AppShell": "/components/AppShell/index",
    "PromptDialog": "/components/PromptDialog/index",
    "ThemeRadialBg": "/components/ThemeRadialBg/index",
    "ItemTile": "/components/ItemTile/index",
    "loading": "/components/loading/index",
    "mask-element": "/components/maskElement/index"
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家庭物资",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationStyle": "custom"
  },
  "servicemarket": true,
  "style": "v2",
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "workers": "workers",
  "useExtendedLib": {
    "weui": true
  }
}
