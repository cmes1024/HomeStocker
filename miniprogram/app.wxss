/**app.wxss**/
@import "./styles/common.wxss";

page {
  width: 100vw;
  height: 100vh;
  background: #f5f5f5;
}

.flex-display {
  display: flex;
  align-items: center;
  justify-content: center;
}
.overflow2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}