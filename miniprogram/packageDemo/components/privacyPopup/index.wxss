/* component/privacyPopup/index.wxss */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  z-index: calc(var(--policyzindex) - 1);
  width: 100%;
  height: 100vh;
  background: rgba(0, 0, 0, .6);
}

.policy-content {
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: var(--policyzindex);
  background: #EDEDED;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  height: 532rpx;
  width: 670rpx;
  padding: 40rpx 40rpx 0;
  padding-bottom: calc(constant(safe-area-inset-bottom));
  padding-bottom: calc(env(safe-area-inset-bottom));
}

.title {
  color: #333;
  font-size: 36rpx;
  line-height: 48rpx;
  margin: 20rpx 0 40rpx;
  font-weight: bold;
}

.content {
  height: 316rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
}

.desc {}

.policy-txt {
  color: #247DFF;
}

.btns {
  display: flex;
  height: 88rpx;
}

.btns-disagree {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #FFFFFF;
  border-radius: 8rpx;
  color: #07C160;
}

.btns-agree {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07C160;
  border-radius: 8rpx;
  color: white;
  margin-left: 20rpx;
}

.btns-agree::after {
  border: none
}

.IpX {
  padding-bottom: 64rpx !important;
}