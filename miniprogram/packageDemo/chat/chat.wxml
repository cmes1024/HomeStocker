<!--pages/chat/chat.wxml-->
<Header page-name="AI 助手" zIndex="10" headerStyle="z-index: 10;background: white" />
<view class="chat-container">
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="msg {{item.role}}"
    >
      <view class="bubble">{{item.content}}</view>
    </view>
    <view class="msg-tail" id="msg-{{messages.length}}"></view>
  </scroll-view>
  <view class="input-bar">
    <input
      class="input"
      value="{{input}}"
      placeholder="问点什么，或记一笔…"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="send"
    />
    <button class="send" size="mini" bindtap="send" disabled="{{sending}}">
      {{sending ? '…' : '发送'}}
    </button>
  </view>
</view>
