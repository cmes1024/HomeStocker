<Header back="{{false}}" page-name="Demo 演示" align-content="center" zIndex="10" headerStyle="z-index: 10;background: white" />

<view class="demo-grid">
  <view
    wx:for="{{demos}}"
    wx:key="id"
    class="demo-card"
    data-id="{{item.id}}"
    bind:tap="goToDemo"
  >
    <view class="demo-card-icon">{{item.icon}}</view>
    <view class="demo-card-body">
      <view class="demo-card-title">{{item.name}}</view>
      <view class="demo-card-desc">{{item.desc}}</view>
    </view>
    <view class="demo-card-arrow">→</view>
  </view>
</view>
