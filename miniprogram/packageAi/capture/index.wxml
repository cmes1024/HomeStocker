<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{bootLoading || extracting || saving}}"
    text="{{extracting ? copy.extracting : (saving ? copy.saving : copy.captureTitle)}}"
    glass
    zIndex="{{200}}"
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{bootError}}">
    <view class="state-text error">{{bootError}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetryBoot">{{common.retry}}</view>
  </view>

  <view class="page" wx:elif="{{!bootLoading}}">
    <block wx:if="{{step === 'collect'}}">
      <view class="hero">
        <view class="kicker">{{copy.captureKicker}}</view>
        <view class="title">{{copy.captureTitle}}</view>
        <view class="sub">{{copy.captureSub}}</view>
      </view>

      <view class="banner" wx:if="{{!hasKey}}">
        <view class="banner-text">{{copy.noKey}}</view>
        <view class="text-link theme-text" bind:tap="goKeys">{{copy.goKeys}}</view>
      </view>

      <view class="row-card" wx:for="{{rows}}" wx:key="index">
        <image class="thumb" src="{{item.path}}" mode="aspectFill" />
        <view class="row-main">
          <textarea
            class="row-input"
            value="{{item.text}}"
            placeholder="写一下这是什么、放哪、数量…"
            maxlength="200"
            auto-height
            data-index="{{item.index}}"
            bindinput="onRowText"
          />
          <view class="row-actions">
            <view class="text-btn danger" data-index="{{item.index}}" bind:tap="removeRow">{{copy.removeRow}}</view>
          </view>
        </view>
      </view>

      <view class="add-row theme-text theme-border" bind:tap="addPhotos">+ {{copy.addPhotos}}</view>

      <view class="bottom-spacer"></view>
      <view class="bottom-bar">
        <view
          class="pill-btn wide theme-btn {{(!rows.length || extracting) ? 'off' : ''}}"
          bind:tap="startExtract"
        >{{copy.startExtract}}</view>
      </view>
    </block>

    <block wx:else>
      <view class="preview-mask"></view>
      <view class="preview-stage">
        <view class="preview-hd">
          <view>
            <view class="kicker">{{copy.previewTitle}}</view>
            <view class="preview-swipe">{{copy.previewSwipe}}</view>
          </view>
          <view class="preview-count" wx:if="{{previewHint}}">{{previewHint}}</view>
        </view>

        <swiper
          class="preview-swiper"
          current="{{previewIndex}}"
          previous-margin="40rpx"
          next-margin="40rpx"
          duration="280"
          snap-to-edge="{{true}}"
          disabled="{{saving}}"
          bindchange="onPreviewChange"
        >
          <swiper-item wx:for="{{cards}}" wx:key="cardKey">
            <view class="float-wrap">
              <view class="slip {{item.abandoned ? 'dim' : ''}} {{item.saved ? 'saved' : ''}}">
                <scroll-view class="slip-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                  <view class="slip-hd" wx:if="{{item.path}}">
                    <image class="slip-thumb" src="{{item.path}}" mode="aspectFill" />
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelName}}</view>
                    <view class="value {{item.name ? '' : 'muted'}}">{{item.name || copy.nameEmpty}}</view>
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelQty}}</view>
                    <view class="value">{{item.quantity}}{{item.unit}}</view>
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelSpace}}</view>
                    <view class="value-col">
                      <view class="value {{item.spaceName ? '' : 'muted'}}">{{item.spaceName || '—'}}</view>
                      <view class="hint theme-text" wx:if="{{item.spaceFallback}}">{{copy.spaceFallback}}</view>
                    </view>
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelLocation}}</view>
                    <view class="value-col">
                      <view class="value {{item.locationName ? '' : 'muted'}}">{{item.locationName || detail.locationNone}}</view>
                      <view class="hint theme-text" wx:if="{{item.willCreateLocation}}">{{copy.willCreateLoc}}</view>
                    </view>
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelTags}}</view>
                    <view class="value {{item.tagNames.length ? '' : 'muted'}}">
                      <block wx:if="{{item.tagNames.length}}">
                        <text wx:for="{{item.tagNames}}" wx:for-item="tagName" wx:for-index="ti" wx:key="*this">{{ti ? ' | ' : ''}}{{tagName}}</text>
                      </block>
                      <block wx:else>{{detail.tagsEmpty}}</block>
                    </view>
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelProduction}}</view>
                    <view class="value {{item.productionDate ? '' : 'muted'}}">{{item.productionDate || detail.dateEmpty}}</view>
                  </view>
                  <view class="field">
                    <view class="label">{{detail.labelExpire}}</view>
                    <view class="value {{item.expireDate ? '' : 'muted'}}">{{item.expireDate || detail.dateEmpty}}</view>
                  </view>
                  <view class="field last">
                    <view class="label">{{detail.labelNote}}</view>
                    <view class="value {{item.note ? '' : 'muted'}}">{{item.note || detail.noteEmpty}}</view>
                  </view>
                  <view class="error" wx:if="{{item.error}}">{{item.error}}</view>
                </scroll-view>
                <view wx:if="{{item.saved}}" class="saved-tag">{{copy.savedCard}}</view>
                <view
                  wx:else
                  class="abandon {{item.abandoned ? 'on' : ''}}"
                  data-i="{{index}}"
                  bind:tap="toggleAbandon"
                >{{copy.abandonCard}}{{item.abandoned ? ' ✓' : ''}}</view>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <view class="bottom-spacer"></view>
      <view class="bottom-bar split">
        <view
          class="pill-btn ghost"
          style="color: {{theme.themeColor}}; border-color: {{theme.themeColor}};"
          bind:tap="backCollect"
        >{{copy.backCollect}}</view>
        <view class="pill-btn theme-btn" bind:tap="onPrimary">{{primaryLabel}}</view>
      </view>
    </block>
  </view>
</AppShell>
