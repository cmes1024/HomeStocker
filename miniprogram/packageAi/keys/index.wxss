.page {
  padding-bottom: 48rpx;
}

.list {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
}

.list-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 24rpx 8rpx;
}

.list-hd-text {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.list-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.38);
  line-height: 1.45;
}

.vision-hint {
  margin: 0 24rpx 8rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.45;
}

.text-btn.add-btn {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #ffffff;
  background: var(--theme-primary);
}

.input {
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 26, 0.04);
  font-size: 28rpx;
  box-sizing: border-box;
}

.input.last {
  margin-bottom: 0;
}

.picker {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.model-line {
  margin: -4rpx 4rpx 16rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #ffffff;
  background: var(--theme-primary);
  vertical-align: 4rpx;
}

/* 当前使用的模型：左侧色条 + 向右淡出的浅底，避免整行重色块 */
.row.active {
  background: linear-gradient(
    90deg,
    var(--theme-primary-30) 0%,
    rgba(255, 255, 255, 0) 46%
  );
  box-shadow: inset 6rpx 0 0 var(--theme-primary);
}

.row.active .row-name {
  font-weight: 600;
}

.row-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
}

.row-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.text-btn {
  font-size: 26rpx;
}

.text-btn.danger {
  color: rgba(250, 81, 81, 0.9);
}

.row.expired .row-name,
.row.expired .row-hint {
  color: rgba(26, 26, 26, 0.38);
}

.empty {
  padding: 36rpx 28rpx 48rpx;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.faq {
  margin-top: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}

.faq-hd {
  margin-bottom: 12rpx;
}

.faq-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.faq-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.4;
}

.faq-item {
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
}

.faq-item:first-of-type {
  border-top: none;
  margin-top: 8rpx;
}

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0;
}

.faq-q-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
}

.faq-chevron {
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: rgba(26, 26, 26, 0.35);
  line-height: 1;
}

.faq-a {
  padding: 0 0 24rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.58);
  line-height: 1.55;
}

.faq-link {
  margin-top: 8rpx;
  height: 72rpx;
  border-radius: 999rpx;
  border-width: 2rpx;
  border-style: solid;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 68rpx;
  text-align: center;
  box-sizing: border-box;
}

.press {
  opacity: 0.6;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(26, 26, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.dialog-panel {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  overflow: auto;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
}

.dialog-title {
  margin-bottom: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.dialog-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 40rpx;
}

.dialog-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.dialog-btn.ghost {
  color: var(--theme-primary);
  background: #ffffff;
  border: 2rpx solid var(--theme-primary);
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.pill-btn {
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}
