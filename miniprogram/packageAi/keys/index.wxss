.page {
  padding-bottom: 48rpx;
}

.hero {
  margin: 8rpx 0 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
}

.kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.45;
}

.form {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  margin-bottom: 24rpx;
}

.input {
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 26, 0.04);
  font-size: 28rpx;
}

.list {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.badge {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--theme-primary);
}

.row-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
}

.row-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.text-btn {
  font-size: 26rpx;
}

.text-btn.danger {
  color: rgba(250, 81, 81, 0.9);
}

.empty {
  padding: 48rpx 28rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
}

.empty-title {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.pill-btn {
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}
