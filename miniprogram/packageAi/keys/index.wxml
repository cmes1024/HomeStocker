<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{loading}}"
    text="{{copy.loading}}"
    glass
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{!loading && error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <view class="page" wx:elif="{{!loading}}">
    <view class="list">
      <view class="list-hd">
        <view class="list-hd-text">
          <view class="list-title">模型</view>
          <view class="list-sub">{{copy.keysHint}}</view>
        </view>
        <view class="text-btn theme-text add-btn" hover-class="press" bind:tap="onOpenAdd">{{copy.addKey}}</view>
      </view>

      <view class="vision-hint" wx:if="{{visionAvailable}}">{{copy.visionHint}}</view>

      <view class="empty" wx:if="{{keys.length === 0 && !hosted}}">
        <view class="empty-title">{{copy.noKeys}}</view>
      </view>

      <view class="row {{hosted.expired ? 'expired' : ''}}" wx:if="{{hosted}}">
        <view class="row-body">
          <view class="row-name">
            {{copy.hostedName}}
            <text class="badge" wx:if="{{hosted.defaulted}}">{{copy.defaultBadge}}</text>
          </view>
          <view class="row-hint">{{hosted.hint}}</view>
        </view>
        <view class="row-actions" wx:if="{{hosted.active && !hosted.defaulted}}">
          <view class="text-btn theme-text" bind:tap="onSetHostedDefault">{{copy.setDefault}}</view>
        </view>
      </view>
      <block wx:if="{{keys.length}}">
      <view class="row" wx:for="{{keys}}" wx:key="_id">
        <view class="row-body">
          <view class="row-name">
            {{item.label}}
            <text class="badge" wx:if="{{item.isDefault}}">{{copy.defaultBadge}}</text>
          </view>
          <view class="row-hint">{{item.providerLabel}} · {{item.model}} · {{item.apiKeyMasked}}</view>
        </view>
        <view class="row-actions">
          <view
            class="text-btn theme-text"
            wx:if="{{!item.isDefault}}"
            data-id="{{item._id}}"
            bind:tap="onSetDefault"
          >{{copy.setDefault}}</view>
          <view class="text-btn danger" data-id="{{item._id}}" bind:tap="onRemove">{{copy.removeKey}}</view>
        </view>
      </view>
      </block>
    </view>

    <view class="faq">
      <view class="faq-hd">
        <view class="faq-title">{{copy.faqTitle}}</view>
        <view class="faq-sub">{{copy.faqHint}}</view>
      </view>
      <view
        class="faq-item"
        wx:for="{{faqItems}}"
        wx:key="id"
      >
        <view
          class="faq-q"
          hover-class="press"
          data-id="{{item.id}}"
          bind:tap="onToggleFaq"
          aria-role="button"
        >
          <text class="faq-q-text">{{item.q}}</text>
          <text class="faq-chevron">{{openFaqId === item.id ? '−' : '+'}}</text>
        </view>
        <view class="faq-a" wx:if="{{openFaqId === item.id}}">{{item.a}}</view>
      </view>
      <view
        class="faq-link theme-text theme-border"
        hover-class="press"
        bind:tap="onCopyDeepseekLink"
      >{{copy.faqCopyLink}}</view>
    </view>
  </view>
</AppShell>

<view
  class="dialog-mask"
  wx:if="{{showAdd}}"
  style="{{theme.cssVarStyle}}"
  catch:touchmove="onNoop"
  catch:tap="onCloseAdd"
>
  <view class="dialog-panel" catch:tap="onNoop">
    <view class="dialog-title">{{copy.addKeyTitle}}</view>
    <picker
      mode="selector"
      range="{{providerNames}}"
      value="{{providerIndex}}"
      bindchange="onProviderChange"
    >
      <view class="input picker">{{providerNames[providerIndex] || '选择平台'}}</view>
    </picker>
    <picker
      wx:if="{{modelNames.length > 1}}"
      mode="selector"
      range="{{modelNames}}"
      value="{{modelIndex}}"
      bindchange="onModelChange"
    >
      <view class="input picker">{{modelNames[modelIndex]}}</view>
    </picker>
    <view class="model-line" wx:else>{{modelNames[modelIndex] || ''}}</view>
    <input
      class="input"
      password
      placeholder="{{copy.keyPlaceholder}}"
      value="{{apiKey}}"
      bindinput="onKeyInput"
    />
    <input
      class="input last"
      placeholder="{{copy.keyLabelPlaceholder}}"
      value="{{label}}"
      maxlength="20"
      bindinput="onLabelInput"
    />
    <view class="dialog-actions">
      <view class="dialog-btn ghost" catch:tap="onCloseAdd">{{common.cancel}}</view>
      <view class="dialog-btn primary theme-btn" catch:tap="onAdd">{{copy.addKey}}</view>
    </view>
  </view>
</view>
