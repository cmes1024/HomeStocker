.hero {
  margin: 8rpx 0 22rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.06);
}

.hero.on-photo,
.panel.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.24;
  color: #1a1a1a;
}

.hero-qty {
  display: inline-block;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

.panel {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 28rpx rgba(40, 30, 20, 0.05);
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.field:last-child {
  border-bottom: none;
}

.label {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.48);
  margin-bottom: 12rpx;
}

.value {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.45;
  word-break: break-word;
}

.value.note.muted {
  color: rgba(26, 26, 26, 0.36);
}

.action-group {
  margin: 30rpx 0 24rpx;
}

.pill-btn,
.ghost-btn {
  text-align: center;
  padding: 22rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.pill-btn {
  color: #fff;
}

.ghost-btn {
  margin-top: 20rpx;
  color: #fa5151;
  background: rgba(250, 81, 81, 0.08);
}

.state {
  text-align: center;
  padding: 96rpx 28rpx;
}

.state-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 18rpx;
}

.state-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(26, 26, 26, 0.58);
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 26rpx;
}
