.detail-page {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - var(--shell-top, 176rpx) - 48rpx);
  box-sizing: border-box;
}

.slip {
  margin-top: 8rpx;
  padding: 8rpx 32rpx 12rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.slip.on-photo {
  background: rgba(255, 255, 255, 0.96);
}

.field {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--theme-primary-30);
}

.field.last {
  border-bottom: none;
}

.label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.45;
}

.value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.45;
  word-break: break-word;
}

.value.muted {
  color: rgba(26, 26, 26, 0.35);
}

.value-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex-wrap: wrap;
}

.value-row .value {
  flex: none;
}

.assist-entry {
  margin-top: 8rpx;
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: right;
}

.recent {
  margin-top: 8rpx;
  padding-top: 20rpx;
  padding-bottom: 16rpx;
  border-top: 1rpx solid var(--theme-primary-30);
}

.recent-title {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.42);
  margin-bottom: 8rpx;
}

.recent-row {
  margin-top: 14rpx;
}

.recent-line {
  font-size: 26rpx;
  color: #1a1a1a;
  line-height: 1.4;
  word-break: break-word;
}

.recent-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.badge.expired {
  color: #fa5151;
  background: rgba(250, 81, 81, 0.12);
}

.badge.expiring {
  color: #c47a1a;
  background: rgba(196, 122, 26, 0.14);
}

.actions-spacer {
  height: 160rpx;
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e6e6e6;
}

.action-btn {
  flex: 1;
  box-sizing: border-box;
  text-align: center;
  padding: 24rpx 20rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.action-btn.ghost {
  background: #ffffff;
  border: 2rpx solid currentColor;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}

.pill-btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
