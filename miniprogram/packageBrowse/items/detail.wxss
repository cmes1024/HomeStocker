.slip {
  margin-top: 12rpx;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 14rpx 36rpx rgba(40, 30, 20, 0.07);
}

.slip.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.slip-kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.slip-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 36rpx;
  line-height: 1.3;
  word-break: break-word;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 10rpx;
}

.value {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.45;
  word-break: break-word;
}

.value.muted {
  color: rgba(26, 26, 26, 0.35);
}

.value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.badge.expired {
  color: #fa5151;
  background: rgba(250, 81, 81, 0.12);
}

.badge.expiring {
  color: #c47a1a;
  background: rgba(196, 122, 26, 0.14);
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pill-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pill-btn.ghost {
  color: #fa5151;
  background: rgba(250, 81, 81, 0.08);
  font-weight: 500;
  letter-spacing: 0;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}
