.page-col {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.panel {
  flex: 1;
  min-height: 0;
  margin: 8rpx -32rpx 0;
  padding: 36rpx 40rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.intro {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.65;
  padding: 4rpx 8rpx 20rpx;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.space-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
  padding-bottom: 16rpx;
}

.space-tile {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx var(--theme-shadow);
}

.space-hd {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.space-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-default {
  flex-shrink: 0;
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.3;
}

.space-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 28rpx;
}

.space-look {
  font-size: 24rpx;
  color: var(--theme-primary);
  line-height: 1.2;
}

.space-icons {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ico-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ico {
  width: 32rpx;
  height: 32rpx;
}

.actions {
  flex-shrink: 0;
  padding: 20rpx 8rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.add-btn {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.press {
  opacity: 0.72;
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(26, 26, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.modal {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.modal-input {
  margin-top: 40rpx;
  width: 100%;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--theme-secondary);
  background: #ffffff;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1a1a1a;
}

.modal-error {
  color: var(--error-color, #fa5151);
  font-size: 24rpx;
  margin: 12rpx 0 0;
  text-align: center;
}

.modal-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 54rpx;
}

.modal-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.modal-btn.ghost {
  color: var(--theme-primary);
  background: #ffffff;
  border: 2rpx solid var(--theme-primary);
}

.modal-btn.primary {
  color: #ffffff;
  border: none;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
}
