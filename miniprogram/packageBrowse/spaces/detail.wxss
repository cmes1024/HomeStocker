page {
  /* 空间氛围：见 utils/spaceAtmosphere.js（预设图 → 家庭氛围 → 渐变） */
}

.space-hero {
  margin: 8rpx 4rpx 22rpx;
  padding: 8rpx 4rpx;
}

.space-hero.on-photo {
  margin: 8rpx 0 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.08);
}

.kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 8rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
}

.section {
  margin-bottom: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 10rpx 28rpx rgba(40, 30, 20, 0.05);
}

.section.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.items-title.on-photo {
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  display: inline-block;
}

.item-row.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.empty.on-photo {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.06);
}

.section-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.4;
}

.section-action {
  flex-shrink: 0;
  font-size: 24rpx;
  padding-top: 4rpx;
}

.loc-empty {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.42);
  padding: 8rpx 0 4rpx;
}

.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
}

.loc-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-actions {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
}

.link {
  font-size: 24rpx;
}

.link.danger {
  color: rgba(250, 81, 81, 0.9);
}

.items-title {
  margin: 8rpx 4rpx 16rpx;
}

.item-row {
  margin-bottom: 16rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 10rpx 28rpx rgba(40, 30, 20, 0.06);
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.item-meta {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
}

.empty {
  text-align: center;
  padding: 40rpx 24rpx 60rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 24rpx;
}

.pill-btn {
  display: inline-block;
  text-align: center;
  padding: 22rpx 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: #fa5151;
  margin-bottom: 24rpx;
}
