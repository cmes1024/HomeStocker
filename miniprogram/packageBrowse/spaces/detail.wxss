.page-col {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.panel {
  flex: 1;
  min-height: 0;
  margin: 8rpx -32rpx 0;
  padding: 36rpx 40rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.scroll-pad {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 4rpx 8rpx;
}

.items-hd {
  margin-top: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.section-action {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.3;
  padding: 8rpx 0 8rpx 16rpx;
}

.loc-empty {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.42);
  padding: 24rpx 4rpx;
}

.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 4rpx;
}

.loc-row + .loc-row {
  border-top: 1rpx solid var(--theme-shadow);
}

.loc-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ico-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ico {
  width: 32rpx;
  height: 32rpx;
}

.press {
  opacity: 0.72;
}

.shelf {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 16rpx;
  row-gap: 16rpx;
  padding: 16rpx 4rpx 8rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 24rpx;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}
