.page-col {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.panel {
  flex: 1;
  min-height: 0;
  margin: 8rpx -32rpx 0;
  padding: 36rpx 40rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(255,255,255, .9);
  display: flex;
  flex-direction: column;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 50vh;
}

.scroll-pad {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 4rpx 8rpx;
}

.items-hd {
  margin-top: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.section-action {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.3;
  padding: 8rpx 0 8rpx 16rpx;
}

.loc-empty {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.42);
  padding: 24rpx 4rpx;
}

.loc-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
  padding: 8rpx 0 8rpx;
}

.loc-tile {
  position: relative;
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx var(--theme-shadow);
  overflow: hidden;
}

.loc-tile.is-on {
  box-shadow: 0 10rpx 28rpx var(--theme-shadow), inset 0 0 0 3rpx var(--theme-primary);
}

.loc-photo {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  width: calc(100% + 32rpx);
  height: calc(100% + 32rpx);
  z-index: 0;
}

.loc-frost {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  background: rgba(255, 255, 255, 0.7);
}

.loc-tile .loc-hd,
.loc-tile .loc-ft {
  position: relative;
  z-index: 1;
}

.loc-hd {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.loc-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 28rpx;
}

.loc-look {
  font-size: 24rpx;
  color: var(--theme-primary);
  line-height: 1.2;
}

.loc-icons {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ico-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ico {
  width: 32rpx;
  height: 32rpx;
}

.press {
  opacity: 0.72;
}

.shelf {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 16rpx;
  row-gap: 16rpx;
  padding: 16rpx 4rpx 8rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 24rpx;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}
