<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{loading}}"
    text="{{copy.listLoading}}"
    glass
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{!loading && error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <view class="page-col" wx:elif="{{!loading}}">
    <view class="panel">
      <view class="intro">{{copy.sub}}</view>

      <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="space-grid">
          <view
            class="space-tile {{item.imageFileID ? 'has-photo' : ''}}"
            wx:for="{{spaces}}"
            wx:key="_id"
            hover-class="press"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            bind:tap="goDetail"
          >
            <image wx:if="{{item.imageFileID}}" class="space-photo" src="{{item.imageFileID}}" mode="aspectFill" />
            <view wx:if="{{item.imageFileID}}" class="space-frost"></view>
            <view class="space-hd">
              <text class="space-name">{{item.name}}</text>
              <text class="space-default" wx:if="{{item.isDefault}}">{{copy.defaultMark}}</text>
            </view>
            <view class="space-ft">
              <text class="space-look">{{copy.lookCta}}</text>
              <view class="space-icons">
                <view
                  class="ico-btn"
                  hover-class="press"
                  data-id="{{item._id}}"
                  data-name="{{item.name}}"
                  catch:tap="openRename"
                >
                  <image class="ico" src="{{editIcon}}" mode="aspectFit" />
                </view>
                <view
                  class="ico-btn"
                  wx:if="{{!item.isDefault}}"
                  hover-class="press"
                  data-id="{{item._id}}"
                  catch:tap="onRemove"
                >
                  <image class="ico" src="{{deleteIcon}}" mode="aspectFit" />
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="actions">
        <view class="add-btn theme-btn" hover-class="press" bind:tap="openCreate">{{copy.createCta}}</view>
      </view>
    </view>
  </view>

  <PromptDialog
    show="{{showModal}}"
    title="{{modalTitle}}"
    placeholder="{{copy.createPlaceholder}}"
    value="{{modalName}}"
    maxlength="{{20}}"
    error="{{modalError}}"
    cancelText="{{common.cancel}}"
    confirmText="{{common.save}}"
    busy="{{acting}}"
    imageSrc="{{modalImagePreview}}"
    imageHint="{{copy.imageHint}}"
    bind:input="onModalName"
    bind:confirm="onSaveModal"
    bind:cancel="closeModal"
    bind:imagechange="onModalImageChange"
    bind:imageclear="onModalImageClear"
  />
</AppShell>
