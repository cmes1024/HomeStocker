<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{false}}"
  centerTitle="{{true}}"
  flushBottom="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <view
    slot="nav-left"
    class="nav-assist"
    hover-class="nav-assist-hover"
    bind:tap="goAssist"
    aria-label="{{copy.assistNavAria}}"
  >
    <view class="nav-assist-dot" aria-hidden="true"></view>
    <text class="nav-assist-label">{{copy.assistNav}}</text>
  </view>

  <loading
    show="{{bootLoading || spaceLoading}}"
    text="{{spaceLoading ? copy.spaceSwitching : copy.bootLoading}}"
    glass
    zIndex="{{200}}"
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{bootError}}">
    <view class="state-text error">{{bootError}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryBoot">{{common.retry}}</view>
  </view>

  <view class="page-col" style="{{pageColHeight ? 'height:' + pageColHeight + 'px;' : ''}}" wx:elif="{{!bootLoading}}">
    <view class="family-bar">
      <view class="family-main">
        <view class="family-name-row" hover-class="press" bind:tap="goFamily">
          <text class="family-name">{{familyName}}</text>
          <view class="family-enter" style="color: {{theme.themeColor}};">
            <text>{{copy.enterFamily}}</text>
          </view>
        </view>
        <view class="family-stats">
          <view class="stat">
            <view wx:if="{{!statsReady.members}}" class="stat-loading"></view>
            <text wx:else>{{memberCount}}</text>
            <text>位成员</text>
          </view>
          <text class="stat-sep">/</text>
          <view class="stat">
            <view wx:if="{{!statsReady.items}}" class="stat-loading"></view>
            <text wx:else>{{itemCount}}</text>
            <text>件物品</text>
          </view>
          <text class="stat-sep">/</text>
          <view class="stat">
            <view wx:if="{{!statsReady.spaces}}" class="stat-loading"></view>
            <text wx:else>{{spaceCount}}</text>
            <text>个空间</text>
          </view>
        </view>
      </view>
      <view class="add-btn theme-btn" bind:tap="goAdd">{{copy.addCta}}</view>
    </view>

    <view
      class="expire-banner"
      wx:if="{{expireBanner}}"
      hover-class="expire-banner-hover"
      catch:tap="goExpireBanner"
    >
      <image class="expire-banner-icon" src="/assets/expire-alert-icon.png" mode="aspectFit" aria-hidden="true" />
      <text class="expire-banner-body">
        <text class="expire-banner-place" style="color: {{theme.themeColor}};" wx:if="{{expireBanner.place}}">【{{expireBanner.place}}】</text>
        <text class="expire-banner-msg" style="color: {{theme.themeColor}};">{{expireBanner.message}}</text>
      </text>
      <view class="expire-banner-chevron" style="color: {{theme.themeColor}};" aria-hidden="true">›</view>
    </view>

    <view class="ledger-panel">
      <view class="panel-hd">
        <view class="panel-title">{{copy.panelTitle}}</view>
        <view class="panel-hd-right">
          <view
            wx:if="{{filterSpaceId}}"
            class="manage-btn"
            hover-class="manage-btn-hover"
            catch:tap="onToggleManage"
          >{{managing ? copy.manageDone : copy.manageEnter}}</view>
          <view class="space-filter" bind:tap="openSpaceSheet">
            <text class="space-filter-name">{{filterSpaceName}}</text>
            <image class="filter-icon" src="/assets/filter-icon.png" mode="aspectFit" aria-hidden="true" />
          </view>
        </view>
      </view>

      <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="state soft" wx:if="{{loading}}">
        <view class="state-text">{{copy.listLoading}}</view>
      </view>

      <view class="state soft" wx:elif="{{error}}">
        <view class="state-text error">{{error}}</view>
        <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryList">{{common.retry}}</view>
      </view>

      <view class="empty" wx:elif="{{items.length === 0}}">
        <view class="empty-title">{{filterSpaceId ? copy.emptySpaceTitle : copy.emptyTitle}}</view>
        <view class="empty-sub">{{filterSpaceId ? copy.emptySpaceSub : copy.emptySub}}</view>
        <view class="pill-btn add-btn" style="background: {{theme.ctaGradient}};" bind:tap="goAdd">{{copy.addCta}}</view>
      </view>

      <block wx:elif="{{!filterSpaceId}}">
        <view class="space-block" wx:for="{{itemGroups}}" wx:key="spaceId">
          <view class="space-block-hd">
            <text class="space-block-name">{{item.name}}</text>
            <text class="space-block-count">{{item.count}}</text>
          </view>
          <view class="space-block-rule" aria-hidden="true"></view>
          <view class="shelf">
            <ItemTile
              wx:for="{{item.items}}"
              wx:for-item="tile"
              wx:key="_id"
              itemId="{{tile._id}}"
              name="{{tile.name}}"
              quantity="{{tile.quantity}}"
              unit="{{tile.unit}}"
              expireStatus="{{tile.expireStatus}}"
              animate="{{animateTiles}}"
              delay="{{index % 9 * 40}}"
              bind:tap="goDetail"
            />
          </view>
        </view>
      </block>

      <view class="shelf" wx:else>
        <ItemTile
          wx:for="{{items}}"
          wx:key="_id"
          itemId="{{item._id}}"
          name="{{item.name}}"
          quantity="{{item.quantity}}"
          unit="{{item.unit}}"
          expireStatus="{{item.expireStatus}}"
          animate="{{animateTiles}}"
          delay="{{index % 9 * 40}}"
          selectable="{{managing}}"
          selected="{{selectedMap[item._id] || false}}"
          bind:tap="onTileTap"
        />
      </view>
      <view class="panel-scroll-pad {{managing ? 'with-batch' : ''}}"></view>
      </scroll-view>

      <view class="batch-bar" wx:if="{{managing}}">
        <text class="batch-bar-count">{{selectedCountLabel}}</text>
        <view
          class="batch-bar-btn {{selectedCount && !batchRemoving ? '' : 'disabled'}}"
          hover-class="{{selectedCount && !batchRemoving ? 'batch-bar-btn-hover' : ''}}"
          bind:tap="onBatchRemove"
        >{{batchRemoveLabel}}</view>
      </view>
    </view>
  </view>
</AppShell>

<page-container
  show="{{sheetOpen}}"
  position="bottom"
  round="{{true}}"
  overlay="{{true}}"
  z-index="100"
  overlay-style="background: rgba(20, 16, 12, 0.28);"
  custom-style="height: 70vh; background: #ffffff;"
  bind:clickoverlay="closeSheet"
  bind:beforeleave="closeSheet"
>
  <view class="sheet" style="{{theme.cssVarStyle}}" wx:if="{{sheetKind === 'space'}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.spaceSheetTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet" aria-label="关闭">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view class="space-chips">
        <view
          class="space-chip {{!filterSpaceId ? 'theme-btn' : ''}}"
          data-id="__all__"
          bind:tap="onPickSpace"
        >{{copy.filterAll}}</view>
        <view
          class="space-chip {{filterSpaceId === item._id ? 'theme-btn' : ''}}"
          wx:for="{{spaces}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bind:tap="onPickSpace"
        >{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="sheet" style="{{theme.cssVarStyle}}" wx:elif="{{sheetKind === 'expire'}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.expiringSheetTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet" aria-label="关闭">×</view>
    </view>
    <scroll-view class="sheet-body expire-sheet-body" scroll-y>
      <view class="expire-sheet-state" wx:if="{{expireSheetLoading}}">{{copy.expiringSheetLoading}}</view>
      <view class="expire-sheet-state soft" wx:elif="{{expireSheetError && !expireList.length}}">{{expireSheetError}}</view>
      <view
        class="expire-row"
        hover-class="expire-row-hover"
        wx:for="{{expireList}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bind:tap="onExpireRowTap"
      >
        <view class="expire-row-main">
          <text class="expire-row-name">{{item.name}}</text>
          <text class="expire-row-place" wx:if="{{item.place}}">{{item.place}}</text>
        </view>
        <text class="expire-row-due" style="color: {{theme.themeColor}};">{{item.dueLabel}}</text>
      </view>
    </scroll-view>
  </view>
</page-container>
