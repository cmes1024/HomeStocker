<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{false}}"
  bgStyle="{{theme.bgStyle}}"
  bgImage="{{theme.bgImage}}"
  lightHeader="{{theme.lightHeader}}"
  themeColor="{{theme.themeColor}}"
>
  <loading
    show="{{bootLoading}}"
    text="{{copy.bootLoading}}"
    glass
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{bootError}}">
    <view class="state-text error">{{bootError}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryBoot">{{common.retry}}</view>
  </view>

  <block wx:elif="{{!bootLoading}}">
    <view class="doorplate {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="doorplate-main" hover-class="doorplate-main-hover" bind:tap="goFamily">
        <text class="doorplate-label">{{copy.familyLabel}}</text>
        <view class="doorplate-name-row" wx:if="{{familyName}}">
          <text class="doorplate-name">{{familyName}}</text>
          <text class="doorplate-chevron">›</text>
        </view>
        <text class="doorplate-hint">{{copy.familyHint}}</text>
      </view>
      <view
        class="note-cta"
        style="color: {{theme.themeColor}}; border-color: {{theme.themeColor}};"
        bind:tap="goAdd"
      >{{copy.addCta}}</view>
    </view>
    <view class="ledger-hint">{{copy.ledgerHint}}</view>

    <view class="expiring {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{expiringItems.length}}">
      <view class="expiring-hd">
        <view class="expiring-title">{{copy.expiringTitle}}</view>
      </view>
      <view
        class="expiring-row"
        wx:for="{{expiringItems}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bind:tap="goDetail"
      >
        <view class="expiring-name">{{item.name}}</view>
        <view class="expiring-meta">
          <text class="badge {{item.expireStatus}}">{{item.expireLabel}}</text>
          <text class="expiring-date">{{item.expireDate}}</text>
        </view>
      </view>
    </view>

    <scroll-view
      class="filter-row"
      scroll-x
      wx:if="{{filterChips.length > 1}}"
      enable-flex
    >
      <view
        class="filter-chip {{filterSpaceId === item.id ? 'on' : ''}}"
        style="{{filterSpaceId === item.id ? 'color:' + theme.themeColor + ';border-color:' + theme.themeColor : ''}}"
        wx:for="{{filterChips}}"
        wx:key="id"
        data-id="{{item.id}}"
        bind:tap="onFilter"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view
      class="filter-row tag-row"
      scroll-x
      wx:if="{{tagChips.length > 1}}"
      enable-flex
    >
      <view
        class="filter-chip {{filterTagId === item.id ? 'on' : ''}}"
        style="{{filterTagId === item.id ? 'color:' + theme.themeColor + ';border-color:' + theme.themeColor : ''}}"
        wx:for="{{tagChips}}"
        wx:key="id"
        data-id="{{item.id}}"
        bind:tap="onFilterTag"
      >{{item.name}}</view>
    </scroll-view>

    <view class="state soft {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{loading}}">
      <view class="state-text">{{copy.listLoading}}</view>
    </view>

    <view class="state soft {{theme.isPhoto ? 'on-photo' : ''}}" wx:elif="{{error}}">
      <view class="state-text error">{{error}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryList">{{common.retry}}</view>
    </view>

    <view class="empty {{theme.isPhoto ? 'on-photo' : ''}}" wx:elif="{{items.length === 0}}">
      <view class="empty-title">{{copy.emptyTitle}}</view>
      <view class="empty-sub">{{copy.emptySub}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="goAdd">{{copy.addCta}}</view>
    </view>

    <view class="shelf {{theme.isPhoto ? 'on-photo' : ''}}" wx:else>
      <view
        class="tile {{animateTiles ? 'anim' : ''}}"
        wx:for="{{items}}"
        wx:key="_id"
        style="{{animateTiles ? 'animation-delay: ' + (index % 8 * 40) + 'ms;' : ''}}"
        data-id="{{item._id}}"
        bind:tap="goDetail"
      >
        <view class="tile-top">
          <view class="tile-name">{{item.name}}</view>
          <view class="tile-qty" style="color: {{theme.themeColor}}; background: {{theme.themeColor}}22;">×{{item.quantity}}{{item.unit}}</view>
        </view>
        <view class="tile-badges" wx:if="{{item.expireLabel}}">
          <text class="badge {{item.expireStatus}}">{{item.expireLabel}}</text>
        </view>
        <view class="tile-note" wx:if="{{item.placeLine}}">{{item.placeLine}}</view>
        <view class="tile-note muted" wx:elif="{{item.tagLine}}">{{item.tagLine}}</view>
        <view class="tile-note muted" wx:else>{{copy.tileHint}}</view>
      </view>
    </view>
  </block>
</AppShell>
