<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{false}}"
  centerTitle="{{true}}"
  flushBottom="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <view slot="nav-left" class="nav-search">
    <view class="search-icon" aria-hidden="true">
      <view class="search-ring"></view>
      <view class="search-handle"></view>
    </view>
    <text class="nav-search-ph">{{copy.searchPlaceholder}}</text>
  </view>

  <loading
    show="{{bootLoading || spaceLoading}}"
    text="{{spaceLoading ? copy.spaceSwitching : copy.bootLoading}}"
    glass
    zIndex="{{200}}"
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{bootError}}">
    <view class="state-text error">{{bootError}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryBoot">{{common.retry}}</view>
  </view>

  <view class="page-col" style="{{pageColHeight ? 'height:' + pageColHeight + 'px;' : ''}}" wx:elif="{{!bootLoading}}">
    <view class="family-bar">
      <view class="family-main">
        <view class="family-name-row">
          <text class="family-name">{{familyName}}</text>
          <view class="family-enter" style="color: {{theme.themeColor}};" bind:tap="goFamily">
            <text>{{copy.enterFamily}}</text>
          </view>
        </view>
        <view class="family-stats">
          <view class="stat">
            <view wx:if="{{!statsReady.members}}" class="stat-loading"></view>
            <text wx:else>{{memberCount}}</text>
            <text>位成员</text>
          </view>
          <text class="stat-sep">/</text>
          <view class="stat">
            <view wx:if="{{!statsReady.items}}" class="stat-loading"></view>
            <text wx:else>{{itemCount}}</text>
            <text>件物品</text>
          </view>
          <text class="stat-sep">/</text>
          <view class="stat">
            <view wx:if="{{!statsReady.spaces}}" class="stat-loading"></view>
            <text wx:else>{{spaceCount}}</text>
            <text>个空间</text>
          </view>
        </view>
      </view>
      <view class="add-btn theme-btn" bind:tap="goAdd">{{copy.addCta}}</view>
    </view>

    <view
      class="expire-banner"
      wx:if="{{expireBanner}}"
      hover-class="expire-banner-hover"
      bind:tap="goMessages"
    >
      <image class="expire-banner-icon" src="/assets/expire-alert-icon.png" mode="aspectFit" aria-hidden="true" />
      <text class="expire-banner-body">
        <text class="expire-banner-place" style="color: {{theme.themeColor}};" wx:if="{{expireBanner.place}}">【{{expireBanner.place}}】</text>
        <text class="expire-banner-msg" style="color: {{theme.themeColor}};">{{expireBanner.message}}</text>
      </text>
      <view class="expire-banner-chevron" style="color: {{theme.themeColor}};" aria-hidden="true">›</view>
    </view>

    <view class="ledger-panel">
      <view class="panel-hd">
        <view class="panel-title">{{copy.panelTitle}}</view>
        <view class="space-filter" bind:tap="openSpaceSheet">
          <text class="space-filter-name">{{filterSpaceName}}</text>
          <image class="filter-icon" src="/assets/filter-icon.png" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>

      <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="state soft" wx:if="{{loading}}">
        <view class="state-text">{{copy.listLoading}}</view>
      </view>

      <view class="state soft" wx:elif="{{error}}">
        <view class="state-text error">{{error}}</view>
        <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryList">{{common.retry}}</view>
      </view>

      <view class="empty" wx:elif="{{items.length === 0}}">
        <view class="empty-title">{{copy.emptyTitle}}</view>
        <view class="empty-sub">{{copy.emptySub}}</view>
        <view class="pill-btn add-btn" style="background: {{theme.ctaGradient}};" bind:tap="goAdd">{{copy.addCta}}</view>
      </view>

      <view class="shelf" wx:else>
        <ItemTile
          wx:for="{{items}}"
          wx:key="_id"
          itemId="{{item._id}}"
          name="{{item.name}}"
          quantity="{{item.quantity}}"
          unit="{{item.unit}}"
          expireStatus="{{item.expireStatus}}"
          animate="{{animateTiles}}"
          delay="{{index % 9 * 40}}"
          bind:tap="goDetail"
        />
      </view>
      <view class="panel-scroll-pad"></view>
      </scroll-view>
    </view>
  </view>
</AppShell>

<page-container
  show="{{spaceSheetOpen}}"
  position="bottom"
  round="{{true}}"
  overlay="{{true}}"
  z-index="100"
  overlay-style="background: rgba(20, 16, 12, 0.28);"
  custom-style="height: 56vh; background: #ffffff;"
  bind:clickoverlay="closeSpaceSheet"
  bind:beforeleave="closeSpaceSheet"
>
  <view class="sheet" style="{{theme.cssVarStyle}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.spaceSheetTitle}}</view>
      <view class="sheet-close" bind:tap="closeSpaceSheet" aria-label="关闭">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view class="space-chips">
        <view
          class="space-chip {{filterSpaceId === item._id ? 'theme-btn' : ''}}"
          wx:for="{{spaces}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bind:tap="onPickSpace"
        >{{item.name}}</view>
      </view>
    </scroll-view>
  </view>
</page-container>

<view
  wx:if="{{theme && !bootLoading && !bootError}}"
  class="ai-fab theme-btn"
  style="{{theme.cssVarStyle}}"
  hover-class="ai-fab-hover"
  bind:tap="goAiCapture"
  aria-label="AI 录入"
>AI</view>
