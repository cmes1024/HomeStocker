<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{false}}"
  bgStyle="{{theme.bgStyle}}"
  bgImage="{{theme.bgImage}}"
  lightHeader="{{theme.lightHeader}}"
  themeColor="{{theme.themeColor}}"
>
  <view class="panel glass" wx:if="{{bootLoading}}">
    <view class="hint">加载中…</view>
  </view>

  <view class="panel glass" wx:elif="{{bootError}}">
    <view class="hint error">{{bootError}}</view>
    <button class="btn primary" style="background: {{theme.themeColor}};" bind:tap="onRetryBoot">重试</button>
  </view>

  <block wx:else>
    <view class="toolbar panel glass">
      <view class="link family-entry" bind:tap="goFamily">
        家庭<text wx:if="{{familyName}}" class="family-name"> {{familyName}}</text>
      </view>
      <view class="link primary" style="color: {{theme.themeColor}};" bind:tap="goAdd">新增</view>
    </view>

    <view wx:if="{{loading}}" class="panel glass">
      <view class="hint">刷新中…</view>
    </view>

    <view wx:elif="{{error}}" class="panel glass">
      <view class="hint error">{{error}}</view>
      <button class="btn primary" style="background: {{theme.themeColor}};" bind:tap="onRetryList">重试</button>
    </view>

    <view wx:elif="{{items.length === 0}}" class="panel glass">
      <view class="hint">还没有物资，点右上角新增</view>
    </view>

    <view wx:else class="list panel glass">
      <view class="row" wx:for="{{items}}" wx:key="_id">
        <view class="row-main" bind:tap="goEdit" data-id="{{item._id}}">
          <view class="name">{{item.name}}</view>
          <view class="meta">数量 {{item.quantity}}<text wx:if="{{item.note}}"> · {{item.note}}</text></view>
        </view>
        <view class="del" catch:tap="onRemove" data-id="{{item._id}}">删</view>
      </view>
    </view>
  </block>
</AppShell>
