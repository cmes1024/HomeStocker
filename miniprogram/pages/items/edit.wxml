<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{!loading}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{loading}}"
    text="{{copy.loading}}"
    glass
    ballColor="{{loadingColors}}"
  />

  <block wx:if="{{!loading}}">
    <view class="edit-page">
      <scroll-view class="slip" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="image-field">
          <view class="image-row">
            <view class="image-slot" wx:for="{{imageSlots}}" wx:key="key">
              <view class="image-hit" bind:tap="onPreviewSlot" data-index="{{index}}">
                <image class="image-preview" src="{{item.preview}}" mode="aspectFill" />
              </view>
              <view class="image-clear" catch:tap="onClearSlot" data-index="{{index}}">×</view>
            </view>
            <view
              class="image-slot image-slot-add"
              wx:if="{{imageSlots.length < 3}}"
              bind:tap="onPickImages"
            >
              <view class="image-empty">
                <text class="image-plus">＋</text>
                <text class="image-hint">{{copy.imageHint}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="field">
          <view class="label">{{copy.labelName}}</view>
          <input
            class="input"
            placeholder="{{copy.namePlaceholder}}"
            placeholder-class="input-placeholder"
            placeholder-style="color: rgba(26, 26, 26, 0.35);"
            value="{{name}}"
            bindinput="onName"
            maxlength="40"
          />
        </view>

        <view class="field">
          <view class="label">{{copy.labelQty}}</view>
          <view class="qty-row">
            <input
              class="input qty-num"
              type="digit"
              placeholder="{{copy.qtyPlaceholder}}"
              placeholder-class="input-placeholder"
              placeholder-style="color: rgba(26, 26, 26, 0.35);"
              value="{{quantity}}"
              bindinput="onQuantity"
            />
            <input
              class="input qty-unit"
              placeholder="{{copy.unitPlaceholder}}"
              placeholder-class="input-placeholder"
              placeholder-style="color: rgba(26, 26, 26, 0.35);"
              value="{{unit}}"
              bindinput="onUnit"
              maxlength="10"
            />
          </view>
        </view>

        <view class="field">
          <view class="label">{{copy.labelSpace}}</view>
          <picker mode="selector" range="{{spaceNames}}" value="{{spaceIndex}}" bindchange="onSpaceChange">
            <view class="input picker">
              <text class="picker-text {{spaceNames[spaceIndex] ? '' : 'placeholder'}}">{{spaceNames[spaceIndex] || copy.spacePlaceholder}}</text>
              <view class="picker-chevron" aria-hidden="true"></view>
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="label-row">
            <view class="label">{{copy.labelLocation}}</view>
            <view class="text-link theme-text" bind:tap="openNewLocation">{{copy.newLocation}}</view>
          </view>
          <picker mode="selector" range="{{locationNames}}" value="{{locationIndex}}" bindchange="onLocationChange">
            <view class="input picker">
              <text class="picker-text">{{locationNames[locationIndex] || copy.locationNone}}</text>
              <view class="picker-chevron" aria-hidden="true"></view>
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="label">{{copy.labelTags}}</view>
          <view class="tag-row" wx:if="{{tags.length}}">
            <view
              class="tag-chip {{item.selected ? 'theme-btn' : ''}}"
              wx:for="{{tags}}"
              wx:key="_id"
              data-id="{{item._id}}"
              bind:tap="onToggleTag"
            >{{item.name}}</view>
          </view>
          <view class="hint muted" wx:else>{{copy.tagsEmpty}}</view>
        </view>

        <view class="field">
          <view class="label-row">
            <view class="label">{{copy.labelProduction}}</view>
            <view class="text-link theme-text" wx:if="{{productionDate}}" bind:tap="clearProductionDate">清除</view>
          </view>
          <picker mode="date" value="{{productionDate}}" bindchange="onProductionDate">
            <view class="input picker">
              <text class="picker-text {{productionDate ? '' : 'placeholder'}}">{{productionDate || copy.datePlaceholder}}</text>
              <view class="picker-chevron" aria-hidden="true"></view>
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="label-row">
            <view class="label">{{copy.labelExpire}}</view>
            <view class="text-link theme-text" wx:if="{{expireDate}}" bind:tap="clearExpireDate">清除</view>
          </view>
          <picker mode="date" value="{{expireDate}}" bindchange="onExpireDate">
            <view class="input picker">
              <text class="picker-text {{expireDate ? '' : 'placeholder'}}">{{expireDate || copy.datePlaceholder}}</text>
              <view class="picker-chevron" aria-hidden="true"></view>
            </view>
          </picker>
        </view>

        <view class="field switch-field" wx:if="{{expireDate}}">
          <view class="switch-text">
            <view class="label">{{copy.labelReminder}}</view>
            <view class="hint muted">{{copy.reminderHint}}</view>
          </view>
          <switch
            checked="{{expireReminderEnabled}}"
            color="{{theme.themeColor}}"
            bindchange="onToggleReminder"
          />
        </view>

        <view class="field last">
          <view class="label">{{copy.labelNote}}</view>
          <input
            class="input"
            placeholder="{{copy.notePlaceholder}}"
            placeholder-class="input-placeholder"
            placeholder-style="color: rgba(26, 26, 26, 0.35);"
            value="{{note}}"
            bindinput="onNote"
            maxlength="100"
          />
        </view>

        <view class="error" wx:if="{{error}}">{{error}}</view>
        <view class="slip-pad"></view>
      </scroll-view>
    </view>

    <view class="actions">
      <mask-element
        id="saveMask"
        isPromise="{{true}}"
        loadAnimation="{{true}}"
        block="{{true}}"
        content-class="mask-full"
        promiseMaxTime="{{30}}"
      >
        <view class="save-btn theme-btn" bind:tap="onSave">{{copy.save}}</view>
      </mask-element>
    </view>
  </block>

  <PromptDialog
    show="{{showNewLocation}}"
    title="{{copy.locModalTitle}}"
    subtitle="{{spaceLabel ? copy.locModalBelong : ''}}"
    subtitleEm="{{spaceLabel}}"
    placeholder="{{copy.locNamePlaceholder}}"
    value="{{newLocationName}}"
    maxlength="{{40}}"
    error="{{modalError}}"
    cancelText="{{common.cancel}}"
    confirmText="{{common.save}}"
    busy="{{creatingLocation}}"
    imageSrc="{{locImagePreview}}"
    imageHint="{{copy.locImageHint}}"
    bind:input="onNewLocationName"
    bind:confirm="onCreateLocation"
    bind:cancel="closeNewLocation"
    bind:imagechange="onLocImageChange"
    bind:imageclear="onLocImageClear"
  />
</AppShell>
