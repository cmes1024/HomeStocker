<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  bgStyle="{{theme.bgStyle}}"
  bgImage="{{theme.bgImage}}"
  lightHeader="{{theme.lightHeader}}"
  themeColor="{{theme.themeColor}}"
>
  <view class="panel glass" wx:if="{{loading}}">
    <view class="hint">加载中…</view>
  </view>

  <view class="panel glass" wx:else>
    <view class="field">
      <view class="label">名称</view>
      <input class="input" placeholder="物资名称" value="{{name}}" bindinput="onName" maxlength="40" />
    </view>
    <view class="field">
      <view class="label">数量</view>
      <input class="input" type="digit" placeholder="0" value="{{quantity}}" bindinput="onQuantity" />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <input class="input" placeholder="可选" value="{{note}}" bindinput="onNote" maxlength="100" />
    </view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button
      class="btn primary"
      style="background: {{theme.themeColor}};"
      loading="{{saving}}"
      disabled="{{saving}}"
      bind:tap="onSave"
    >保存</button>
  </view>
</AppShell>
