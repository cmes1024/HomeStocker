.panel.glass {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  border: 1rpx solid #e5e5e5;
}

.btn.primary {
  margin-top: 24rpx;
  color: #fff;
  border-radius: 12rpx;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
}

.hint {
  text-align: center;
  color: #666;
  padding: 48rpx 0;
}
