.slip {
  margin-top: 12rpx;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 14rpx 36rpx rgba(40, 30, 20, 0.07);
}

.slip.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.slip-kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.slip-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 36rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 12rpx;
}

.input {
  background: rgba(255, 255, 255, 0.88);
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.06);
}

.pill-btn {
  margin-top: 20rpx;
  text-align: center;
  padding: 22rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}
