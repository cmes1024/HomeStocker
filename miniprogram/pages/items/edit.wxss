.edit-page {
  height: calc(100vh - var(--shell-top, 88px));
  box-sizing: border-box;
}

.slip {
  height: 100%;
  padding: 28rpx 28rpx 0;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 0 10px 0 var(--theme-shadow);
  box-sizing: border-box;
}

.slip-pad {
  height: 180rpx;
  height: calc(180rpx + constant(safe-area-inset-bottom));
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.image-field {
  margin-bottom: 28rpx;
}

.image-row {
  display: flex;
  gap: 16rpx;
}

.image-slot {
  position: relative;
  flex: 1;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f6f4f1;
}

.image-slot-add {
  background: transparent;
}

.image-hit {
  width: 100%;
  height: 100%;
}

.image-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.image-empty {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 2rpx dashed var(--theme-primary-30, rgba(196, 164, 132, 0.45));
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.image-plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--theme-primary, #c4a484);
}

.image-hint {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.38);
}

.image-clear {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(26, 26, 26, 0.48);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
}

.field {
  margin-bottom: 28rpx;
}

.field.last {
  margin-bottom: 8rpx;
}

.label {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 14rpx;
  line-height: 1.3;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.input {
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  border: 1rpx solid var(--theme-primary-30);
  box-sizing: border-box;
}

.qty-row {
  display: flex;
  gap: 20rpx;
}

.qty-num,
.qty-unit {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 1.4;
  padding: 0 24rpx;
}

.picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-text.placeholder,
.input-placeholder {
  color: rgba(26, 26, 26, 0.35);
}

.picker-chevron {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-right: 3rpx solid rgba(26, 26, 26, 0.28);
  border-bottom: 3rpx solid rgba(26, 26, 26, 0.28);
  transform: rotate(-45deg);
  margin-right: 4rpx;
}

.text-link {
  font-size: 26rpx;
  flex-shrink: 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  height: 52rpx;
  padding: 0rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  background: #ffffff;
  border: 1rpx solid var(--theme-primary-30);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.tag-chip.theme-btn {
  color: #ffffff;
  border: none;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
}

.hint.muted {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.4);
  line-height: 1.4;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-text {
  flex: 1;
  min-width: 0;
}

.switch-text .label {
  margin-bottom: 6rpx;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e6e6e6;
}

.save-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* mask-element 默认 width:fit-content，必须盖掉才能通栏 */
.mask-full {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box;
}
