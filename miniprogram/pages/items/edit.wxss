.edit-page {
  height: calc(100vh - var(--shell-top, 88px));
  box-sizing: border-box;
}

.slip {
  height: 100%;
  padding: 28rpx 28rpx 0;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 0 10px 0 var(--theme-shadow);
  box-sizing: border-box;
}

.slip-pad {
  height: 180rpx;
  height: calc(180rpx + constant(safe-area-inset-bottom));
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.field {
  margin-bottom: 28rpx;
}

.field.last {
  margin-bottom: 8rpx;
}

.label {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 14rpx;
  line-height: 1.3;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.input {
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  border: 1rpx solid var(--theme-primary-30);
  box-sizing: border-box;
}

.qty-row {
  display: flex;
  gap: 20rpx;
}

.qty-num,
.qty-unit {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 1.4;
  padding: 0 24rpx;
}

.picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-text.placeholder {
  color: rgba(26, 26, 26, 0.35);
}

.picker-chevron {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-right: 3rpx solid rgba(26, 26, 26, 0.28);
  border-bottom: 3rpx solid rgba(26, 26, 26, 0.28);
  transform: rotate(-45deg);
  margin-right: 4rpx;
}

.text-link {
  font-size: 26rpx;
  flex-shrink: 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  height: 52rpx;
  padding: 0rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  background: #ffffff;
  border: 1rpx solid var(--theme-primary-30);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.tag-chip.theme-btn {
  color: #ffffff;
  border: none;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
}

.hint.muted {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.4);
  line-height: 1.4;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-text {
  flex: 1;
  min-width: 0;
}

.switch-text .label {
  margin-bottom: 6rpx;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e6e6e6;
}

.save-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* mask-element 默认 width:fit-content，必须盖掉才能通栏 */
.mask-full {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(26, 26, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.modal {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 12rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.45;
  text-align: center;
  margin-bottom: 52rpx;
}

.modal-space {
  color: #1a1a1a;
}

.modal-input {
  margin-bottom: 8rpx;
  width: 100%;
}

.modal-error {
  color: var(--error-color, #fa5151);
  font-size: 24rpx;
  margin: 8rpx 0 4rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 68rpx;
}

.modal-btn-cell {
  flex: 1;
  min-width: 0;
}

.modal-btn-cell .mask-full {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
}

.modal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  padding: 0;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  overflow: hidden;
}

.modal-btn.ghost {
  color: var(--theme-primary);
  background: #ffffff;
  border: 2rpx solid var(--theme-primary);
}

.modal-btn.primary {
  color: #ffffff;
  border: none;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
}
