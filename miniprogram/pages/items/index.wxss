.nav-search {
  height: 100%;
  max-width: 248rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid rgba(26, 26, 26, 0.38);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-handle {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 10rpx;
  height: 3rpx;
  background: rgba(26, 26, 26, 0.38);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.nav-search-ph {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.38);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-col {
  height: calc(100vh - var(--shell-top, 88px));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.family-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 4rpx 0 32rpx;
}

.family-main {
  flex: 1;
  min-width: 0;
}

.family-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.family-name {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 128rpx);
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-enter {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.family-stats {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.4;
  white-space: nowrap;
}

.stat {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-sep {
  margin: 0 8rpx;
}

.stat-loading {
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(26, 26, 26, 0.12);
  border-top-color: rgba(26, 26, 26, 0.45);
  border-radius: 50%;
  animation: stat-spin 0.7s linear infinite;
}

@keyframes stat-spin {
  to {
    transform: rotate(360deg);
  }
}

.add-btn {
  flex-shrink: 0;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.expiring {
  flex-shrink: 0;
  margin: 0 0 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 248, 230, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.expiring-hd {
  margin-bottom: 12rpx;
}

.expiring-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.expiring-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
}

.expiring-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expiring-meta {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.expiring-date {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
}

.ledger-panel {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 28rpx 16rpx 0;
  margin-bottom: 20px;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 16rpx 40rpx rgba(40, 30, 20, 0.06);
}

.panel-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.panel-scroll-pad {
  height: calc(20rpx + env(safe-area-inset-bottom));
}

.panel-hd {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 12rpx 18rpx;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.space-filter {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 240rpx;
  padding: 8rpx 4rpx;
}

.space-filter-name {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.funnel {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.funnel-top {
  position: absolute;
  left: 0;
  top: 2rpx;
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 12rpx solid rgba(26, 26, 26, 0.55);
}

.funnel-stem {
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 6rpx;
  height: 8rpx;
  background: rgba(26, 26, 26, 0.55);
  border-radius: 1rpx;
}

.shelf {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.tile {
  width: calc(33.333% - 12rpx);
  margin: 6rpx;
  padding: 20rpx 16rpx 18rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.tile.anim {
  animation: tile-in 0.42s ease both;
}

.tile-hover {
  opacity: 0.72;
}

.tile-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-qty-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 8rpx;
  margin-top: 20rpx;
  min-width: 0;
}

.tile-qty {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
}

.tile-unit {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1;
}

.badge {
  font-size: 22rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 600;
  line-height: 1.4;
}

.badge.expired {
  color: #e85d5d;
  background: rgba(250, 81, 81, 0.14);
}

.badge.expiring {
  color: #e09a3e;
  background: rgba(224, 154, 62, 0.16);
}

.sheet {
  height: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: rgba(26, 26, 26, 0.45);
}

.sheet-body {
  height: calc(56vh - 160rpx);
}

.space-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.space-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  background: #fff;
  border: 1rpx solid rgba(26, 26, 26, 0.08);
  box-shadow: 0 6rpx 16rpx rgba(40, 30, 20, 0.05);
}

.space-chip.on {
  color: #fff;
  font-weight: 600;
  box-shadow: none;
}

@keyframes tile-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty {
  margin-top: 48rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.55;
  margin-bottom: 40rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state.soft {
  padding: 48rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.62);
  line-height: 1.5;
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}

.pill-btn {
  display: inline-block;
  margin-top: 8rpx;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
}
