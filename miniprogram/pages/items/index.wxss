.doorplate {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 8rpx 0 12rpx;
  padding: 8rpx 4rpx 20rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.08);
}

.doorplate.on-photo {
  padding: 24rpx 28rpx 22rpx;
  border-radius: 28rpx;
  border-bottom: none;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.08);
  align-items: center;
}

.doorplate-main {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.doorplate-main-hover {
  opacity: 0.72;
}

.doorplate-label {
  display: block;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

.doorplate-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
  max-width: 100%;
}

.doorplate-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doorplate-chevron {
  flex-shrink: 0;
  font-size: 44rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.35);
  line-height: 1;
  margin-top: -4rpx;
}

.doorplate-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
}

.note-cta {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  margin-bottom: 8rpx;
}

.doorplate.on-photo .note-cta {
  margin-bottom: 0;
  background: #fff;
}

.ledger-hint {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
  margin: 0 4rpx 20rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

.filter-row {
  white-space: nowrap;
  margin: 0 0 20rpx;
  padding-bottom: 4rpx;
}

.filter-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.62);
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(26, 26, 26, 0.08);
}

.filter-chip.on {
  background: rgba(255, 255, 255, 0.95);
  font-weight: 600;
}

.shelf {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.tile {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 28rpx 24rpx 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 10rpx 28rpx rgba(40, 30, 20, 0.06);
}

.tile.anim {
  animation: tile-in 0.42s ease both;
}

.shelf.on-photo .tile {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(255, 255, 255, 0.95);
}

.tile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.tile-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
  word-break: break-word;
}

.tile-qty {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.tile-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tile-note.muted {
  color: rgba(26, 26, 26, 0.32);
}

@keyframes tile-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty {
  margin-top: 72rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty.on-photo,
.state.on-photo {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.06);
}

.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.55;
  margin-bottom: 40rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state.soft {
  padding: 48rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.62);
  line-height: 1.5;
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}

.pill-btn {
  display: inline-block;
  margin-top: 8rpx;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
}
