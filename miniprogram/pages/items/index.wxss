.nav-search {
  height: 100%;
  max-width: 248rpx;
  min-width: 118rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  padding: 0 30rpx;
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  transform: translateY(15%);
}

.search-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid rgba(26, 26, 26, 0.38);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-handle {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 10rpx;
  height: 3rpx;
  background: rgba(26, 26, 26, 0.38);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.nav-search-ph {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.38);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-col {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.family-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 4rpx 0 32rpx;
  padding-left: 20rpx;
}

.family-main {
  flex: 1;
  min-width: 0;
}

.family-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.family-name {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 128rpx);
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-enter {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.family-stats {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.4;
  white-space: nowrap;
}

.stat {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-sep {
  margin: 0 14rpx;
}

.stat-loading {
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(26, 26, 26, 0.12);
  border-top-color: rgba(26, 26, 26, 0.45);
  border-radius: 50%;
  animation: stat-spin 0.7s linear infinite;
}

@keyframes stat-spin {
  to {
    transform: rotate(360deg);
  }
}

.add-btn {
  height: 70rpx;
  flex-shrink: 0;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  height: 35rpx;
  display: flex;
  align-items: center;
}

.expire-banner {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin: 0 0 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--theme-shadow) 0%, white 100%);
  border: 2rpx solid #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(26, 16, 8, 0.06);
  box-sizing: border-box;
}

.expire-banner-hover {
  opacity: 0.88;
}

.expire-banner-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
}

.expire-banner-body {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 1.35;
}

.expire-banner-place {
  font-weight: 700;
}

.expire-banner-msg {
  font-weight: 400;
}

.expire-banner-chevron {
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  opacity: 0.72;
}

.ledger-panel {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  min-height: 0;
  margin: 0 -32rpx 0;
  padding: 28rpx 32rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(255, 255, 255, 1);
  border: none;
  box-shadow: none;
}

.panel-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.panel-scroll-pad {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.panel-hd {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 12rpx 18rpx;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 400;
  color: #1a1a1a;
}

.space-filter {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 240rpx;
  padding: 8rpx 4rpx;
}

.space-filter-name {
  font-size: 28rpx;
  color: #3d3d3d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.funnel {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.funnel-top {
  position: absolute;
  left: 0;
  top: 2rpx;
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 12rpx solid rgba(26, 26, 26, 0.55);
}

.funnel-stem {
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 6rpx;
  height: 8rpx;
  background: rgba(26, 26, 26, 0.55);
  border-radius: 1rpx;
}

.shelf {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 20rpx;
  row-gap: 16rpx;
  padding: 12rpx 8rpx 20rpx;
  box-sizing: border-box;
}

.sheet {
  height: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: rgba(26, 26, 26, 0.45);
}

.sheet-body {
  height: calc(56vh - 160rpx);
}

.space-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.space-chip {
  display: inline-block;
  max-width: 95%;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  background: #fff;
  box-shadow: 0px 2px 10px 0px rgba(209, 209, 209, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 选中态：盖过 .space-chip 白底，走主题按钮左→右渐变 */
.space-chip.theme-btn {
  color: #fff;
  box-shadow: none;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
}

.empty {
  margin-top: 48rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.55;
  margin-bottom: 40rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state.soft {
  padding: 48rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.62);
  line-height: 1.5;
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  margin-top: 8rpx;
  padding: 0rpx 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
}

/* 清单右下角：玻璃浮片，不当实心贴片 */
.assist-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 50;
  padding: 10rpx;
}

.assist-fab-halo {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 999rpx;
  opacity: 0.9;
  transform: scale(1.08);
  pointer-events: none;
}

.assist-fab-core {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 0 30rpx 0 22rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--theme-shadow);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow:
    0 18rpx 40rpx rgba(26, 16, 8, 0.14),
    0 4rpx 12rpx rgba(26, 16, 8, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(36px);
  -webkit-backdrop-filter: blur(18px);
}

.assist-fab-dot {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
  box-shadow: 0 0 16rpx var(--theme-primary-30, rgba(0, 0, 0, 0.12));
}

.assist-fab-label {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: rgba(26, 26, 26, 0.78);
  line-height: 1;
}

.assist-fab-hover .assist-fab-core {
  background: rgba(255, 255, 255, 0.88);
  transform: translateY(2rpx) scale(0.98);
  box-shadow:
    0 10rpx 24rpx rgba(26, 16, 8, 0.12),
    0 2rpx 8rpx rgba(26, 16, 8, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
