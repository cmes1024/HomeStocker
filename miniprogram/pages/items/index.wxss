.panel.glass {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.link {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 8rpx;
}

.family-entry {
  color: #1a1a1a;
  font-weight: 500;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-name {
  font-weight: 500;
}

.link.primary {
  font-weight: 500;
  flex-shrink: 0;
}

.list {
  padding: 0;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.del {
  padding: 12rpx 16rpx;
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
}

.hint {
  text-align: center;
  color: #666;
  padding: 48rpx 0;
  font-size: 28rpx;
}

.hint.error {
  color: var(--error-color, #fa5151);
  padding: 24rpx 0 16rpx;
}

.btn.primary {
  margin-top: 8rpx;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
