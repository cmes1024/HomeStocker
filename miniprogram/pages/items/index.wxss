.page {
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.link {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 8rpx;
}

.link.primary {
  color: var(--main-color, #007bff);
  font-weight: 500;
}

.list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.del {
  padding: 12rpx 16rpx;
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
}

.hint {
  text-align: center;
  color: #666;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.hint.error {
  color: var(--error-color, #fa5151);
  padding: 40rpx 0 16rpx;
}

.panel {
  text-align: center;
}

.btn.primary {
  margin-top: 16rpx;
  background: var(--main-color, #007bff);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
