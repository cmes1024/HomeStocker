.panel.glass {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.hero {
  margin-bottom: 40rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  border: 1rpx solid #e5e5e5;
}

.btn {
  margin-top: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn.primary {
  color: #fff;
}

.btn.ghost {
  background: rgba(255, 255, 255, 0.95);
  color: #1a1a1a;
  border: 1rpx solid #ddd;
}

.btn.link {
  background: transparent;
  color: #666;
  font-size: 28rpx;
}

.hint {
  text-align: center;
  color: #666;
  padding: 48rpx 0;
  font-size: 28rpx;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
}

.hint.error {
  padding-bottom: 24rpx;
}
