.welcome {
  margin-top: 48rpx;
  padding: 8rpx 8rpx 40rpx;
}

.welcome.on-photo {
  margin-top: 24rpx;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(40, 30, 20, 0.07);
}

.welcome-kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.welcome-title {
  font-size: 56rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.welcome-sub {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.55;
  margin-bottom: 56rpx;
  max-width: 560rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 12rpx;
}

.input {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 10rpx 24rpx rgba(40, 30, 20, 0.05);
}

.pill-btn {
  margin-top: 12rpx;
  text-align: center;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
}

.ghost-btn {
  margin-top: 20rpx;
  text-align: center;
  padding: 22rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.text-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.45);
  padding: 16rpx;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}
