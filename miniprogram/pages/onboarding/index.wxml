<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{false}}"
  bgStyle="{{theme.bgStyle}}"
  bgImage="{{theme.bgImage}}"
  lightHeader="{{theme.lightHeader}}"
  themeColor="{{theme.themeColor}}"
>
  <view class="state" wx:if="{{bootLoading}}">
    <view class="state-text">{{copy.bootLoading}}</view>
  </view>

  <view class="state" wx:elif="{{bootError}}">
    <view class="state-text error">{{bootError}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetryBoot">{{common.retry}}</view>
  </view>

  <view class="welcome {{theme.isPhoto ? 'on-photo' : ''}}" wx:else>
    <view class="welcome-kicker">{{copy.kicker}}</view>
    <view class="welcome-title">{{copy.title}}</view>
    <view class="welcome-sub">{{copy.sub}}</view>

    <block wx:if="{{mode === 'choose'}}">
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="goCreate">{{copy.createCta}}</view>
      <view class="ghost-btn" bind:tap="goJoin">{{copy.joinCta}}</view>
    </block>

    <block wx:elif="{{mode === 'create'}}">
      <view class="field">
        <view class="label">{{copy.nameLabel}}</view>
        <input class="input" placeholder="{{copy.namePlaceholder}}" value="{{familyName}}" bindinput="onNameInput" maxlength="20" />
      </view>
      <view class="error" wx:if="{{formError}}">{{formError}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onCreate">
        {{submitting ? copy.creating : copy.createSubmit}}
      </view>
      <view class="text-btn" bind:tap="goChoose">{{common.back}}</view>
    </block>

    <block wx:else>
      <view class="field">
        <view class="label">{{copy.codeLabel}}</view>
        <input class="input" placeholder="{{copy.codePlaceholder}}" value="{{inviteCode}}" bindinput="onCodeInput" maxlength="6" />
      </view>
      <view class="error" wx:if="{{formError}}">{{formError}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onJoin">
        {{submitting ? copy.joining : copy.joinSubmit}}
      </view>
      <view class="text-btn" bind:tap="goChoose">{{common.back}}</view>
    </block>
  </view>
</AppShell>
