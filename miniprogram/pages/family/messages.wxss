.page-col {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.panel {
  flex: 1;
  min-height: 0;
  margin: 8rpx -32rpx 0;
  padding: 36rpx 48rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.intro {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.65;
  padding: 4rpx 4rpx 12rpx;
}

.empty {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx 160rpx;
  box-sizing: border-box;
}

.empty-img {
  width: 440rpx;
  height: 440rpx;
}

.empty-title {
  margin-top: -12rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.5;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid var(--theme-shadow);
}

.row-avatar-wrap {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-top: 4rpx;
}

.row-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0ece6;
}

.row-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-initial {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1;
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.row-line {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
  word-break: break-word;
}

.row-time {
  flex-shrink: 0;
  padding-top: 4rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.35);
  line-height: 1.5;
}

.list-pad {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
}
