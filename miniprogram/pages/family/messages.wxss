.hero {
  margin: 8rpx 0 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
}

.hero.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.45;
}

.list {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
}

.list.on-photo,
.empty.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.row {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row.muted .row-line {
  color: rgba(26, 26, 26, 0.55);
}

.row-line {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.45;
  word-break: break-word;
}

.row-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
}

.empty {
  padding: 48rpx 28rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
}

.empty-title {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}
