<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{loading}}"
    text="{{copy.loading}}"
    glass
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{!loading && error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <view class="page-col" wx:elif="{{!loading}}">
    <view class="panel">
      <view class="intro">{{copy.sub}}</view>

      <view class="empty" wx:if="{{rows.length === 0}}">
        <image class="empty-img" src="/assets/no_data.png" mode="aspectFit" />
        <view class="empty-title">{{copy.empty}}</view>
      </view>

      <scroll-view wx:else class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          class="row"
          wx:for="{{rows}}"
          wx:key="_id"
          data-id="{{item.itemId}}"
          data-action="{{item.action}}"
          bind:tap="onOpenItem"
        >
          <view class="row-avatar-wrap">
            <image
              wx:if="{{item.avatarUrl}}"
              class="row-avatar"
              src="{{item.avatarUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="row-avatar placeholder">
              <text class="row-initial">{{item.initial}}</text>
            </view>
          </view>
          <view class="row-main">
            <view class="row-line">{{item.line}}</view>
            <view class="row-time">{{item.timeLabel}}</view>
          </view>
        </view>
        <view class="list-pad"></view>
      </scroll-view>
    </view>
  </view>
</AppShell>
