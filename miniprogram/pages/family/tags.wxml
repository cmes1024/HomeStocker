<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <view class="state" wx:if="{{loading}}">
    <view class="state-text">{{copy.loading}}</view>
  </view>

  <view class="state" wx:elif="{{error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <block wx:else>
    <view class="hero {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="kicker">{{copy.kicker}}</view>
      <view class="title">{{copy.title}}</view>
      <view class="sub">{{copy.sub}}</view>
    </view>

    <view class="create-row {{theme.isPhoto ? 'on-photo' : ''}}">
      <input
        class="input"
        placeholder="{{copy.createPlaceholder}}"
        value="{{newName}}"
        bindinput="onNewName"
        maxlength="20"
        confirm-type="done"
        bindconfirm="onCreate"
      />
      <view
        class="pill-btn compact"
        style="background: {{theme.themeColor}};"
        bind:tap="onCreate"
      >{{copy.createSubmit}}</view>
    </view>

    <view class="empty {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{tags.length === 0}}">
      <view class="empty-title">{{copy.empty}}</view>
    </view>

    <view class="list {{theme.isPhoto ? 'on-photo' : ''}}" wx:else>
      <view class="row" wx:for="{{tags}}" wx:key="_id">
        <view class="row-name">{{item.name}}</view>
        <view class="row-actions">
          <view
            class="text-btn"
            style="color: {{theme.themeColor}};"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            bind:tap="onRename"
          >{{copy.rename}}</view>
          <view
            class="text-btn danger"
            data-id="{{item._id}}"
            bind:tap="onRemove"
          >{{copy.remove}}</view>
        </view>
      </view>
    </view>
  </block>
</AppShell>
