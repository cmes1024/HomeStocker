.hero {
  margin: 8rpx 0 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
}

.hero.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.45;
}

.create-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
}

.create-row.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 26, 0.04);
  font-size: 28rpx;
}

.pill-btn.compact {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.list {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
}

.list.on-photo,
.empty.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.row-actions {
  display: flex;
  gap: 24rpx;
}

.text-btn {
  font-size: 26rpx;
}

.text-btn.danger {
  color: rgba(250, 81, 81, 0.9);
}

.empty {
  padding: 48rpx 28rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
}

.empty-title {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}
