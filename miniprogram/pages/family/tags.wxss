.page-col {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.panel {
  flex: 1;
  min-height: 0;
  margin: 8rpx -32rpx 0;
  padding: 36rpx 48rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.intro {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.65;
  padding: 4rpx 4rpx 12rpx;
}

.empty {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.empty-img {
  width: 440rpx;
  height: 440rpx;
}

.empty-title {
  margin-top: -12rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.5;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid var(--theme-shadow);
}

.row-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.ico-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ico {
  width: 36rpx;
  height: 36rpx;
}

.actions {
  flex-shrink: 0;
  padding: 20rpx 8rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.add-btn {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.press {
  opacity: 0.7;
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 70rpx;
}
