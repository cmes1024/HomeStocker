.card {
  margin: 0 0 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 40rpx 0 var(--theme-shadow);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.key-card {
  padding-bottom: 32rpx;
}

.key-shadow {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 50px;
  opacity: 0.4;
}

.key-hd {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.key-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.key-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.3;
}

.key-icon {
  width: 18rpx;
  height: 32rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.push-row {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: -10rpx;
}

.push-label {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--theme-primary);
  margin-right: -20rpx;
}

.push-switch {
  height: 48rpx;
  display: flex;
  align-items: center;
  transform: scale(0.68);
  transform-origin: center right;
}

.key-code-row {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  position: relative;
  z-index: 1;
}

.key-code {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: var(--theme-primary);
}

.key-copy {
  margin-left: 16rpx;
  padding: 6rpx 22rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.2;
  border: 0.5px solid var(--theme-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.key-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666666;
  position: relative;
  z-index: 1;
}

.card-title {
  color: #1a1a1a;
  line-height: 1.35;
}

.homes-title {
  font-size: 32rpx;
  font-weight: 600;
}

.tool-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 8rpx 36rpx;
}

.tool {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-hover {
  opacity: 0.72;
}

.tool-icon {
  width: 140rpx;
  height: 100rpx;
}

.tool-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.2;
  text-align: center;
}

.ai-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 40rpx 0 var(--theme-shadow);
  box-sizing: border-box;
}

.ai-row-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.ai-row-chevron {
  font-size: 36rpx;
  font-weight: 300;
  color: rgba(26, 26, 26, 0.35);
  line-height: 1;
}

.homes-card {
  padding: 32rpx 32rpx 36rpx;
}

.home-list {
  margin-top: 8rpx;
}

.home-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx dashed rgba(26, 26, 26, 0.16);
}

.home-item:last-child {
  border-bottom: none;
}

.home-hover {
  opacity: 0.72;
}

.home-mark {
  width: 6rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 4rpx;
  background: transparent;
  flex-shrink: 0;
}

.home-mark.on {
  background: var(--theme-primary);
}

.home-body {
  flex: 1;
  min-width: 0;
}

.home-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.35;
}

.form {
  margin-top: 8rpx;
  padding: 16rpx 0 8rpx;
}

.home-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.outline-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 999rpx;
  border-width: 2rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  background: #ffffff;
}

.outline-btn.on {
  background: var(--theme-shadow);
}

.actions-spacer {
  height: 160rpx;
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e6e6e6;
}

.leave-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.leave-hover {
  opacity: 0.86;
}

.press {
  opacity: 0.6;
}

.sheet {
  height: 100%;
  box-sizing: border-box;
  padding: 32rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: rgba(26, 26, 26, 0.45);
}

.sheet-body {
  height: calc(72vh - 128rpx);
  box-sizing: border-box;
}

.sheet-pad {
  height: calc(32rpx + constant(safe-area-inset-bottom));
  height: calc(32rpx + env(safe-area-inset-bottom));
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  margin-bottom: 16rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.preset-chip {
  position: relative;
  width: calc(50% - 16rpx);
  height: 88rpx;
  margin: 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.preset-chip-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
}

.preset-label {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.75);
  background: rgba(255, 255, 255, 0.55);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.preset-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.preset-check::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 10rpx;
  height: 16rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.input {
  background: #f4f6f8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(26, 26, 26, 0.04);
}

.form-error {
  color: #fa5151;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.pill-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.state {
  text-align: center;
  padding: 96rpx 32rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: #fa5151;
  margin-bottom: 32rpx;
}
