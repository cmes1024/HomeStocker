.home-hero {
  margin: 8rpx 0 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.08);
}

.home-kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.home-name {
  font-size: 52rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.home-meta {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
}

.sticky {
  margin-bottom: 22rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 248, 230, 0.94);
  border: 1rpx dashed rgba(180, 140, 80, 0.35);
  box-shadow: 0 12rpx 28rpx rgba(40, 30, 20, 0.05);
  transform: rotate(-0.4deg);
}

.block {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 10rpx 28rpx rgba(40, 30, 20, 0.05);
}

.block.on-photo {
  background: rgba(255, 255, 255, 0.94);
}

.block-sub {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
  line-height: 1.45;
}

.mood-panel {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
}

.leave {
  margin: 36rpx 0 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(250, 81, 81, 0.9);
  padding: 20rpx;
}

.leave.on-photo {
  margin: 28rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(40, 30, 20, 0.06);
}

.sticky-label {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 14rpx;
}

.sticky-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sticky-code {
  font-size: 44rpx;
  letter-spacing: 6rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.sticky-copy {
  font-size: 26rpx;
  padding: 8rpx 12rpx;
}

.sticky-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.4;
}

.block-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.block-action {
  font-size: 26rpx;
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 12rpx;
}

.label.spaced {
  margin-top: 28rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.preset-chip {
  width: calc(50% - 16rpx);
  height: 88rpx;
  margin: 8rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: flex-end;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.preset-label {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.75);
  background: rgba(255, 255, 255, 0.55);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.preset-dot {
  width: 64rpx;
  height: 64rpx;
  margin: 8rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.chip-row {
  margin-top: 8rpx;
}

.chip {
  padding: 22rpx 0 22rpx 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid transparent;
}

.chip.on {
  border-left-color: currentColor;
}

.chip:last-of-type {
  border-bottom: none;
}

.chip.on .chip-name {
  font-weight: 600;
}

.chip-name {
  font-size: 30rpx;
  margin-bottom: 6rpx;
}

.chip-meta {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.text-btn {
  font-size: 26rpx;
  padding: 16rpx 8rpx 8rpx 0;
  margin-right: 28rpx;
  color: #1a1a1a;
}

.text-btn.muted {
  color: rgba(26, 26, 26, 0.45);
  margin-right: 0;
}

.photo-upload {
  margin-top: 4rpx;
  margin-bottom: 8rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx dashed;
  background: rgba(255, 255, 255, 0.55);
  text-align: center;
  box-sizing: border-box;
}

.photo-upload-hover {
  opacity: 0.72;
}

.photo-upload-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.photo-upload-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.3;
}

.input {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.06);
}

.form-error {
  color: var(--error-color, #fa5151);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.pill-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 22rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
}

.state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: var(--error-color, #fa5151);
  margin-bottom: 24rpx;
}
