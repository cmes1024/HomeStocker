.card {
  margin: 0 0 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 40rpx 0 var(--theme-shadow);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.key-card {
  padding-bottom: 32rpx;
}

.key-shadow {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 50px;
  opacity: 0.4;
}

.key-hd {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.key-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.key-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.3;
}

.key-icon {
  width: 18rpx;
  height: 32rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.push-row {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: -10rpx;
}

.push-label {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--theme-primary);
  margin-right: -20rpx;
}

.push-switch {
  height: 48rpx;
  display: flex;
  align-items: center;
  transform: scale(0.68);
  transform-origin: center right;
}

.key-code-row {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  position: relative;
  z-index: 1;
}

.key-code {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: var(--theme-primary);
  min-width: 0;
}

.key-eye {
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.key-eye-ico {
  width: 28rpx;
  height: 28rpx;
}

.key-copy {
  margin-left: 8rpx;
  padding: 6rpx 22rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.2;
  border: 0.5px solid var(--theme-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.key-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666666;
  position: relative;
  z-index: 1;
}

.member-list-avatar,
.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0ece6;
}

.member-list-avatar.placeholder,
.profile-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-initial {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(26, 26, 26, 0.72);
  line-height: 1;
}

.member-initial.sm {
  font-size: 28rpx;
}

.members-sheet-body {
  flex: 1;
  height: 0;
  min-height: 0;
}

.members-empty {
  padding: 48rpx 8rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.42);
  text-align: center;
}

.member-list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.member-list-avatar-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
}

.member-list-avatar {
  width: 72rpx;
  height: 72rpx;
}

.member-list-body {
  flex: 1;
  min-width: 0;
}

.member-list-name {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-list-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.3;
}

.profile-body {
  padding: 8rpx 8rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 120rpx;
  height: 120rpx;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn .profile-avatar {
  width: 120rpx;
  height: 120rpx;
}

.profile-avatar-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.4);
  text-align: center;
  align-self: center;
}

.profile-label {
  align-self: stretch;
  margin-top: 36rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
}

.profile-input {
  align-self: stretch;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f6f4f1;
  font-size: 30rpx;
  color: #1a1a1a;
}

.profile-save {
  align-self: stretch;
  margin-top: 36rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.card-title {
  color: #1a1a1a;
  line-height: 1.35;
}

.homes-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.homes-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.homes-title {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.homes-profile-link {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
  flex-shrink: 0;
}

.homes-help {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(26, 26, 26, 0.28);
  color: rgba(26, 26, 26, 0.45);
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
  box-sizing: border-box;
  align-items: center;
  display: flex;
  justify-content: center;
}

.tool-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 8rpx 36rpx;
}

.tool {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-hover {
  opacity: 0.72;
}

.tool-icon {
  width: 140rpx;
  height: 100rpx;
}

.tool-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.2;
  text-align: center;
}

.ai-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 40rpx 0 var(--theme-shadow);
  box-sizing: border-box;
}

.ai-row-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.ai-row-chevron {
  font-size: 36rpx;
  font-weight: 300;
  color: rgba(26, 26, 26, 0.35);
  line-height: 1;
}

.capacity-row {
  align-items: flex-start;
}

.capacity-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.capacity-sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.35;
}

.issue-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  background: rgba(20, 16, 12, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.issue-card {
  width: 100%;
  max-height: 70vh;
  overflow: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.issue-title {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.7);
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.issue-field {
  margin-bottom: 24rpx;
}

.issue-label {
  display: block;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 12rpx;
}

.issue-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.04);
  font-size: 30rpx;
}

.issue-input-sm {
  width: 160rpx;
  flex-shrink: 0;
}

.issue-duration-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.issue-unit-row {
  display: flex;
  flex: 1;
  gap: 8rpx;
  min-width: 0;
}

.issue-unit {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  background: rgba(0, 0, 0, 0.04);
}

.issue-unit.on {
  color: #1a1a1a;
  font-weight: 600;
  background: var(--theme-primary-30, rgba(196, 164, 132, 0.28));
}

.issue-check {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  background: rgba(0, 0, 0, 0.04);
}

.issue-check.on {
  color: var(--theme-primary);
  background: var(--theme-primary-30);
}

.platform-card {
  max-height: 80vh;
  overflow: auto;
}

.platform-card .issue-input {
  margin-top: 16rpx;
}

.platform-empty {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.45);
}

.platform-row {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.platform-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.platform-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
}

.platform-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.text-link {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.62);
}

.text-link.danger {
  color: rgba(250, 81, 81, 0.9);
}

.issue-error {
  font-size: 24rpx;
  color: #c45c4a;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.issue-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.issue-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.issue-btn-ghost {
  background: rgba(0, 0, 0, 0.05);
  color: rgba(26, 26, 26, 0.65);
}

.issue-btn.busy {
  opacity: 0.55;
  pointer-events: none;
}

.issue-days {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin: -8rpx 0 16rpx;
}

.issue-code {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.issue-copy {
  margin-top: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  color: #fff;
  background: var(--theme-primary, #ff5d00);
}

.homes-card {
  padding: 32rpx 32rpx 36rpx;
}

.home-list {
  margin-top: 8rpx;
}

.home-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx dashed rgba(26, 26, 26, 0.16);
}

.home-item:last-child {
  border-bottom: none;
}

.home-hover {
  opacity: 0.72;
}

.home-mark {
  width: 6rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 4rpx;
  background: transparent;
  flex-shrink: 0;
}

.home-mark.on {
  background: var(--theme-primary);
}

.home-body {
  flex: 1;
  min-width: 0;
}

.home-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.home-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  flex-shrink: 1;
}

.home-capacity {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.35;
  white-space: nowrap;
}

.home-capacity.on {
  color: var(--theme-primary);
}

.home-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.35;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.home-members-link {
  font-weight: 500;
  padding: 8rpx 12rpx;
  margin: -8rpx -4rpx;
  border-radius: 8rpx;
  line-height: 1.35;
}

.home-rename {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-rename-ico {
  width: 28rpx;
  height: 28rpx;
}

.home-vip-ico {
  width: 40rpx;
  height: 40rpx;
}

.home-ico-btn {
  width: 56rpx;
  height: 56rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.outline-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 999rpx;
  border-width: 2rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  background: #ffffff;
}

.actions-spacer {
  height: 160rpx;
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e6e6e6;
}

.leave-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.leave-hover {
  opacity: 0.86;
}

.press {
  opacity: 0.6;
}

.sheet {
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
  padding: 32rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: rgba(26, 26, 26, 0.45);
}

.sheet-body {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.sheet-pad {
  height: calc(32rpx + constant(safe-area-inset-bottom));
  height: calc(32rpx + env(safe-area-inset-bottom));
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  margin-bottom: 16rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.preset-chip {
  position: relative;
  width: calc(33.333% - 16rpx);
  height: 88rpx;
  margin: 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.preset-chip-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
}

.preset-label {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.75);
  background: rgba(255, 255, 255, 0.55);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.preset-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.preset-check::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 10rpx;
  height: 16rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.pill-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.state {
  text-align: center;
  padding: 96rpx 32rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: #fa5151;
  margin-bottom: 32rpx;
}
