.panel.glass {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.label.spaced {
  margin-top: 28rpx;
}

.value {
  font-size: 32rpx;
  color: #1a1a1a;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code {
  font-size: 40rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.copy {
  font-size: 28rpx;
  padding: 8rpx 12rpx;
}

.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-action {
  font-size: 26rpx;
  padding: 4rpx 0;
}

.section-sub {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.preset-chip {
  width: calc(50% - 16rpx);
  height: 88rpx;
  margin: 8rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: flex-end;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.preset-label {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.75);
  background: rgba(255, 255, 255, 0.55);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.preset-dot {
  width: 64rpx;
  height: 64rpx;
  margin: 8rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.family-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.family-item:last-of-type {
  border-bottom: none;
}

.family-item-name {
  font-size: 30rpx;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.family-item-meta {
  font-size: 22rpx;
  color: #999;
}

.action-row {
  display: flex;
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.action {
  font-size: 26rpx;
  padding: 8rpx 0;
  margin-right: 32rpx;
}

.input {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  border: 1rpx solid #e5e5e5;
}

.form-error {
  color: var(--error-color, #fa5151);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.btn.primary {
  margin-top: 24rpx;
  color: #fff;
  border-radius: 12rpx;
}

.btn.ghost {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #1a1a1a;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
}

.btn.link {
  margin-top: 8rpx;
  background: transparent;
  color: #666;
  font-size: 28rpx;
}

.btn.danger {
  margin-top: 40rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--error-color, #fa5151);
  border: 1rpx solid #f5c2c2;
  border-radius: 12rpx;
}

.hint {
  text-align: center;
  color: #666;
  padding: 48rpx 0;
  font-size: 28rpx;
}

.hint.error {
  color: var(--error-color, #fa5151);
  padding-bottom: 24rpx;
}
