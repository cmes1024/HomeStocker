.card {
  margin: 0 0 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 48rpx rgba(40, 30, 20, 0.06);
  box-sizing: border-box;
}

.card.on-photo {
  background: rgba(255, 255, 255, 0.96);
}

.card.glass,
.card.glass.on-photo {
  overflow: hidden;
  background: rgba(255, 255, 255, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.62);
  box-shadow: none;
  backdrop-filter: blur(36rpx);
  -webkit-backdrop-filter: blur(36rpx);
}

.key-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
}

.key-code-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.key-code {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.key-copy {
  margin-left: 16rpx;
  padding: 8rpx 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.2;
}

.key-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.45;
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  color: #1a1a1a;
  line-height: 1.35;
}

.tools-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.homes-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hd-links {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.hd-link {
  margin-left: 24rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.2;
}

.hd-link:first-child {
  margin-left: 0;
}

.hd-link.on {
  font-weight: 500;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.tool {
  width: calc(33.333% - 20rpx);
  margin: 10rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background: #f1f4f8;
}

.tool.on {
  background: #e7eef6;
}

.tool-hover {
  opacity: 0.72;
}

.tool-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #c8cdd3;
  flex-shrink: 0;
}

.tool-name {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-list {
  margin-top: 12rpx;
}

.home-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx dashed rgba(26, 26, 26, 0.16);
}

.home-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.home-hover {
  opacity: 0.72;
}

.home-mark {
  width: 6rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 4rpx;
  background: transparent;
  flex-shrink: 0;
}

.home-body {
  flex: 1;
  min-width: 0;
}

.home-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.35;
}

.form {
  margin-top: 24rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid rgba(26, 26, 26, 0.06);
}

.leave-spacer {
  height: 168rpx;
  height: calc(168rpx + constant(safe-area-inset-bottom));
  height: calc(168rpx + env(safe-area-inset-bottom));
}

.leave-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  background: #fff;
}

.leave-bar::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  height: 96rpx;
  background: #fff;
}

.leave-btn {
  margin: 0;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.3;
  pointer-events: auto;
}

.leave-hover {
  opacity: 0.86;
}

.press {
  opacity: 0.6;
}

.sheet {
  height: 100%;
  box-sizing: border-box;
  padding: 32rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: rgba(26, 26, 26, 0.45);
}

.sheet-body {
  height: calc(72vh - 128rpx);
  box-sizing: border-box;
}

.sheet-pad {
  height: calc(32rpx + constant(safe-area-inset-bottom));
  height: calc(32rpx + env(safe-area-inset-bottom));
}

.label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  margin-bottom: 16rpx;
}

.label.spaced {
  margin-top: 32rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.preset-chip {
  width: calc(50% - 16rpx);
  height: 88rpx;
  margin: 8rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.preset-label {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.75);
  background: rgba(255, 255, 255, 0.55);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.preset-chip.on {
  box-shadow: inset 0 0 0 4rpx rgba(26, 26, 26, 0.55);
}

.preset-dot {
  width: 64rpx;
  height: 64rpx;
  margin: 8rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
}

.preset-dot.on {
  transform: scale(1.06);
}

.text-btn {
  font-size: 24rpx;
  padding: 20rpx 0 8rpx;
  color: #1a1a1a;
}

.text-btn.muted {
  color: rgba(26, 26, 26, 0.45);
}

.photo-upload {
  position: relative;
  margin-top: 4rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx dashed;
  background: rgba(255, 255, 255, 0.55);
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
}

.photo-upload.has-photo {
  height: 296rpx;
  padding: 0;
  border-style: solid;
}

.photo-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-preview-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 44rpx 24rpx 20rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.46) 100%);
}

.photo-upload.has-photo .photo-upload-title {
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.photo-upload-hover {
  opacity: 0.72;
}

.photo-upload-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.3;
}

.photo-upload-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.3;
}

.input {
  background: #f4f6f8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(26, 26, 26, 0.04);
}

.form-error {
  color: #fa5151;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.pill-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.state {
  text-align: center;
  padding: 96rpx 32rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: #fa5151;
  margin-bottom: 32rpx;
}
