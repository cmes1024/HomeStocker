.page {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.value {
  font-size: 32rpx;
  color: #1a1a1a;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code {
  font-size: 40rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.copy {
  color: var(--main-color, #007bff);
  font-size: 28rpx;
  padding: 8rpx 12rpx;
}

.btn.primary {
  background: var(--main-color, #007bff);
  color: #fff;
  border-radius: 12rpx;
}

.btn.danger {
  margin-top: 64rpx;
  background: #fff;
  color: var(--error-color, #fa5151);
  border: 1rpx solid #f5c2c2;
  border-radius: 12rpx;
}

.hint {
  text-align: center;
  color: #666;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.hint.error {
  color: var(--error-color, #fa5151);
  padding-bottom: 24rpx;
}
