<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{!!family && !loading && !error}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{loading || switching}}"
    text="{{switching ? copy.switching : copy.loading}}"
    glass
    zIndex="{{200}}"
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{!loading && error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <block wx:elif="{{!loading && family}}">
    <view class="card key-card">
      <view class="key-shadow" style="background: linear-gradient(180deg, {{theme.secondary}} 3%, {{theme.shadow}} 95%, white)"></view>
      <view class="key-hd">
        <view class="key-title-row">
          <text class="key-title">{{copy.keyTitle}}</text>
          <image class="key-icon" src="{{keyIcon}}" mode="aspectFit" aria-hidden="true" />
        </view>
        <view class="push-row">
          <text class="push-label">{{copy.reminderTitle}}</text>
          <view class="push-switch">
            <switch
              checked="{{reminderEnabled}}"
              color="{{theme.themeColor}}"
              disabled="{{acting}}"
              bindchange="onTogglePush"
            />
          </view>
        </view>
      </view>
      <view class="key-code-row">
        <text class="key-code">{{codeDisplay}}</text>
        <view
          class="key-eye"
          hover-class="press"
          bind:tap="onToggleCodeVisible"
          aria-role="button"
          aria-label="{{codeVisible ? '隐藏邀请码' : '显示邀请码'}}"
        >
          <image
            class="key-eye-ico"
            src="{{codeVisible ? eyeOpenIcon : eyeOffIcon}}"
            mode="aspectFit"
          />
        </view>
        <text
          class="key-copy theme-text"
          hover-class="press"
          bind:tap="onCopyCode"
        >{{copy.keyCopy}}</text>
      </view>
      <view class="key-hint">{{copy.keyHint}}</view>
    </view>

    <view
      class="card profile-card"
      hover-class="home-hover"
      bind:tap="openProfileSheet"
    >
      <view class="profile-row-avatar-wrap">
        <image
          wx:if="{{profile.avatarUrl}}"
          class="profile-row-avatar"
          src="{{profile.avatarUrl}}"
          mode="aspectFill"
        />
        <view
          wx:else
          class="profile-row-avatar placeholder"
          style="background: {{theme.secondary}};"
        >
          <text class="member-initial">{{profileInitial}}</text>
        </view>
      </view>
      <view class="profile-row-body">
        <view class="profile-row-name">{{profileDisplayName}}</view>
        <view class="profile-row-hint">{{copy.profileHint}}</view>
      </view>
      <text class="profile-row-chevron">›</text>
    </view>

    <view class="tool-grid">
      <view class="tool" hover-class="tool-hover" bind:tap="goSpaces">
        <image class="tool-icon" src="/assets/space.png" mode="aspectFit" />
        <view class="tool-name">{{copy.spacesTitle}}</view>
      </view>
      <view class="tool" hover-class="tool-hover" bind:tap="goTags">
        <image class="tool-icon" src="/assets/tag.png" mode="aspectFit" />
        <view class="tool-name">{{copy.tagsTitle}}</view>
      </view>
      <view class="tool" hover-class="tool-hover" bind:tap="goMessages">
        <image class="tool-icon" src="/assets/message.png" mode="aspectFit" />
        <view class="tool-name">{{copy.messagesTitle}}</view>
      </view>
      <view class="tool" hover-class="tool-hover" bind:tap="openMoodSheet">
        <image class="tool-icon" src="/assets/theme.png" mode="aspectFit" />
        <view class="tool-name">{{copy.wallTitle}}</view>
      </view>
    </view>

    <view class="card homes-card">
      <view class="homes-hd">
        <view class="card-title homes-title">{{copy.myHomes}}</view>
        <view
          class="homes-help"
          hover-class="press"
          catch:tap="onCapacityHelp"
          aria-role="button"
          aria-label="{{copy.capacityHelpAria}}"
        >?</view>
      </view>

      <view class="home-list">
        <view
          class="home-item {{item.isCurrent ? 'on' : ''}}"
          wx:for="{{families}}"
          wx:key="_id"
          hover-class="home-hover"
          data-id="{{item._id}}"
          bind:tap="onSwitchFamily"
        >
          <view class="home-mark {{item.isCurrent ? 'on' : ''}}"></view>
          <view class="home-body">
            <view class="home-name-row">
              <text class="home-name">{{item.name}}</text>
              <text
                wx:if="{{item.isCurrent && capacityStatusText}}"
                class="home-capacity {{capacityActive ? 'on' : ''}}"
              >{{capacityStatusText}}</text>
            </view>
            <view class="home-sub">
              <block wx:if="{{item.isCurrent}}">
                <text>{{copy.chipHere}} / </text>
                <view
                  class="home-members-link theme-text"
                  hover-class="press"
                  catch:tap="openMembersSheet"
                  aria-role="button"
                  aria-label="{{copy.membersTitle}}"
                >{{item.memberCount || 0}}人</view>
              </block>
              <text wx:else>{{item.memberCount || 0}}人</text>
            </view>
          </view>
          <view
            class="home-rename"
            hover-class="press"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            catch:tap="openRename"
          >
            <image class="home-rename-ico" src="{{editIcon}}" mode="aspectFit" />
          </view>
          <view
            wx:if="{{item.isCurrent}}"
            class="home-ico-btn"
            hover-class="press"
            catch:tap="goAiKeys"
            aria-role="button"
            aria-label="{{copy.aiQuota}}"
          >
            <image class="home-rename-ico" src="{{aiIcon}}" mode="aspectFit" />
          </view>
          <view
            wx:if="{{item.isCurrent}}"
            class="home-ico-btn"
            hover-class="press"
            catch:tap="openCapacityRedeem"
            aria-role="button"
            aria-label="{{copy.capacityTitle}}"
          >
            <image class="home-rename-ico" src="{{vipIcon}}" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="home-actions">
        <view
          class="outline-btn theme-text theme-border"
          hover-class="press"
          data-mode="create"
          bind:tap="openModal"
        >{{copy.createAnother}}</view>
        <view
          class="outline-btn theme-text theme-border"
          hover-class="press"
          data-mode="join"
          bind:tap="openModal"
        >{{copy.joinAnother}}</view>
      </view>
    </view>

    <view
      wx:if="{{family.isAdmin}}"
      class="ai-row capacity-row"
      hover-class="tool-hover"
      bind:tap="openIssueCodes"
    >
      <view class="capacity-main">
        <text class="ai-row-name">{{copy.issueTitle}}</text>
        <text class="capacity-sub">{{copy.issueSub}}</text>
      </view>
      <text class="ai-row-chevron">›</text>
    </view>

    <view class="actions-spacer"></view>
    <view class="actions">
      <view
        class="leave-btn theme-btn"
        hover-class="leave-hover"
        bind:tap="onLeave"
      >{{family.isOwner ? copy.leaveOwner : copy.leaveMember}}</view>
    </view>
  </block>
</AppShell>

<view class="issue-mask" wx:if="{{issuedCodes.length}}" bind:tap="closeIssued">
  <view class="issue-card" catch:tap="noop">
    <view class="issue-title">{{copy.issueResultTitle}}</view>
    <view class="issue-code" wx:for="{{issuedCodes}}" wx:key="*this">{{item}}</view>
    <view class="issue-copy theme-btn" bind:tap="copyIssued">{{copy.issueCopyAll}}</view>
  </view>
</view>

<PromptDialog
  show="{{showModal}}"
  title="{{modalTitle}}"
  placeholder="{{modalPlaceholder}}"
  value="{{modalValue}}"
  maxlength="{{modalMaxlength}}"
  error="{{modalError}}"
  cancelText="{{common.cancel}}"
  confirmText="{{modalConfirm}}"
  busy="{{acting}}"
  bind:input="onModalInput"
  bind:confirm="onSaveModal"
  bind:cancel="closeModal"
/>

<page-container
  show="{{sheetShow}}"
  position="bottom"
  round="{{true}}"
  overlay="{{true}}"
  z-index="100"
  overlay-style="background: rgba(20, 16, 12, 0.28);"
  custom-style="height: {{sheetHeight}}; background: #ffffff;"
  bind:clickoverlay="closeSheet"
  bind:beforeleave="closeSheet"
>
  <view class="sheet" wx:if="{{sheetKind === 'mood'}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.wallTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="label">{{copy.themePick}}</view>
      <view class="preset-row">
        <view
          class="preset-chip {{theme && theme.id === item.id ? 'on' : ''}}"
          wx:for="{{themes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bind:tap="onPickTheme"
        >
          <view class="preset-chip-bg">
            <ThemeRadialBg
              primary="{{item.primary}}"
              secondary="{{item.secondary}}"
              shadow="{{item.shadow}}"
            />
          </view>
          <text class="preset-label">{{item.label}}</text>
          <view
            class="preset-check"
            wx:if="{{theme && theme.id === item.id}}"
            style="color: {{theme.primary}};"
            aria-hidden="true"
          ></view>
        </view>
      </view>
      <view class="sheet-pad"></view>
    </scroll-view>
  </view>

  <view class="sheet" wx:elif="{{sheetKind === 'members'}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.membersTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="members-empty" wx:if="{{!members.length}}">{{copy.membersEmpty}}</view>
      <view
        class="member-list-row {{item.isMe ? 'me' : ''}}"
        wx:for="{{members}}"
        wx:key="openid"
      >
        <view class="member-list-avatar-wrap">
          <image
            wx:if="{{item.avatarUrl}}"
            class="member-list-avatar"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
          <view
            wx:else
            class="member-list-avatar placeholder"
            style="background: {{theme.secondary}};"
          >
            <text class="member-initial sm">{{item.initial}}</text>
          </view>
        </view>
        <view class="member-list-body">
          <view class="member-list-name">{{item.displayName}}</view>
          <view class="member-list-meta" wx:if="{{item.isOwner || item.isMe}}">
            <text wx:if="{{item.isOwner}}">{{copy.ownerBadge}}</text>
            <text wx:if="{{item.isOwner && item.isMe}}"> · </text>
            <text wx:if="{{item.isMe}}">{{copy.meBadge}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-pad"></view>
    </scroll-view>
  </view>

  <view class="sheet" wx:elif="{{sheetKind === 'profile'}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.profileSheetTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <view class="profile-body">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{profileDraftAvatar}}"
          class="profile-avatar"
          src="{{profileDraftAvatar}}"
          mode="aspectFill"
        />
        <view
          wx:else
          class="profile-avatar placeholder"
          style="background: {{theme.secondary}};"
        >
          <text class="member-initial">{{profileDraftInitial}}</text>
        </view>
      </button>
      <view class="profile-avatar-hint">{{copy.profileAvatarHint}}</view>
      <view class="profile-label">{{copy.profileNickLabel}}</view>
      <input
        class="profile-input"
        type="nickname"
        maxlength="20"
        value="{{profileDraftNickname}}"
        placeholder="{{copy.profileNickPlaceholder}}"
        bindinput="onProfileNickInput"
        bindblur="onProfileNickBlur"
      />
      <view
        class="profile-save theme-btn"
        hover-class="press"
        bind:tap="onSaveProfile"
      >{{copy.profileSave}}</view>
    </view>
  </view>
</page-container>
