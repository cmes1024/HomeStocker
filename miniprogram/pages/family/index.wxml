<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{!!family && !loading && !error}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{loading || switching}}"
    text="{{switching ? copy.switching : copy.loading}}"
    glass
    zIndex="{{200}}"
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{!loading && error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <block wx:elif="{{!loading && family}}">
    <view class="card key-card">
      <view class="key-shadow" style="background: linear-gradient(180deg, {{theme.secondary}} 3%, {{theme.shadow}} 95%, white)"></view>
      <view class="key-hd">
        <view class="key-title-row">
          <text class="key-title">{{copy.keyTitle}}</text>
          <image class="key-icon" src="{{keyIcon}}" mode="aspectFit" aria-hidden="true" />
        </view>
        <view
          class="push-btn"
          hover-class="press"
          bind:tap="openReminderSheet"
          aria-role="button"
          aria-label="{{reminderButtonText}}"
        >{{reminderButtonText}}</view>
      </view>
      <view class="key-code-row">
        <text class="key-code">{{codeDisplay}}</text>
        <view
          class="key-eye"
          hover-class="press"
          bind:tap="onToggleCodeVisible"
          aria-role="button"
          aria-label="{{codeVisible ? '隐藏邀请码' : '显示邀请码'}}"
        >
          <image
            class="key-eye-ico"
            src="{{codeVisible ? eyeOpenIcon : eyeOffIcon}}"
            mode="aspectFit"
          />
        </view>
        <text
          class="key-copy theme-text"
          hover-class="press"
          bind:tap="onCopyCode"
        >{{copy.keyCopy}}</text>
      </view>
      <view class="key-hint">{{copy.keyHint}}</view>
    </view>

    <view class="tool-grid">
      <view class="tool" hover-class="tool-hover" bind:tap="goSpaces">
        <image class="tool-icon" src="/assets/space.png" mode="aspectFit" />
        <view class="tool-name">{{copy.spacesTitle}}</view>
      </view>
      <view class="tool" hover-class="tool-hover" bind:tap="goTags">
        <image class="tool-icon" src="/assets/tag.png" mode="aspectFit" />
        <view class="tool-name">{{copy.tagsTitle}}</view>
      </view>
      <view class="tool" hover-class="tool-hover" bind:tap="goMessages">
        <image class="tool-icon" src="/assets/message.png" mode="aspectFit" />
        <view class="tool-name">{{copy.messagesTitle}}</view>
      </view>
      <view class="tool" hover-class="tool-hover" bind:tap="openMoodSheet">
        <image class="tool-icon" src="/assets/theme.png" mode="aspectFit" />
        <view class="tool-name">{{copy.wallTitle}}</view>
      </view>
    </view>

    <view class="card homes-card">
      <view class="homes-hd">
        <view class="homes-title-row">
          <view class="card-title homes-title">{{copy.myHomes}}</view>
          <view
            class="homes-profile-link theme-text"
            hover-class="press"
            catch:tap="openProfileSheet"
            aria-role="button"
            aria-label="{{copy.profileEntry}}"
          >{{copy.profileEntry}}</view>
        </view>
        <view
          class="homes-help"
          hover-class="press"
          catch:tap="onCapacityHelp"
          aria-role="button"
          aria-label="{{copy.capacityHelpAria}}"
        >?</view>
      </view>

      <view class="home-list">
        <view
          class="home-item {{item.isCurrent ? 'on' : ''}}"
          wx:for="{{families}}"
          wx:key="_id"
          hover-class="home-hover"
          data-id="{{item._id}}"
          bind:tap="onSwitchFamily"
        >
          <view class="home-mark {{item.isCurrent ? 'on' : ''}}"></view>
          <view class="home-body">
            <view class="home-name-row">
              <text class="home-name">{{item.name}}</text>
              <text
                wx:if="{{item.isCurrent && capacityStatusText}}"
                class="home-capacity {{capacityActive ? 'on' : ''}}"
              >{{capacityStatusText}}</text>
            </view>
            <view class="home-sub">
              <block wx:if="{{item.isCurrent}}">
                <text>{{copy.chipHere}} / </text>
                <view
                  class="home-members-link theme-text"
                  hover-class="press"
                  catch:tap="openMembersSheet"
                  aria-role="button"
                  aria-label="{{copy.membersTitle}}"
                >{{item.memberCount || 0}}人</view>
              </block>
              <text wx:else>{{item.memberCount || 0}}人</text>
            </view>
          </view>
          <view
            class="home-rename"
            hover-class="press"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            catch:tap="openRename"
          >
            <image class="home-rename-ico" src="{{editIcon}}" mode="aspectFit" />
          </view>
          <view
            wx:if="{{item.isCurrent}}"
            class="home-ico-btn"
            hover-class="press"
            catch:tap="goAiKeys"
            aria-role="button"
            aria-label="{{copy.aiQuota}}"
          >
            <image class="home-rename-ico" src="{{aiIcon}}" mode="aspectFit" />
          </view>
          <view
            wx:if="{{item.isCurrent}}"
            class="home-ico-btn"
            hover-class="press"
            catch:tap="openCapacityRedeem"
            aria-role="button"
            aria-label="{{copy.capacityTitle}}"
          >
            <image class="home-rename-ico home-vip-ico" src="{{vipIcon}}" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="home-actions">
        <view
          class="outline-btn theme-text theme-border"
          hover-class="press"
          data-mode="create"
          bind:tap="openModal"
        >{{copy.createAnother}}</view>
        <view
          class="outline-btn theme-text theme-border"
          hover-class="press"
          data-mode="join"
          bind:tap="openModal"
        >{{copy.joinAnother}}</view>
      </view>
    </view>

    <view
      wx:if="{{family.isAdmin}}"
      class="ai-row capacity-row"
      hover-class="tool-hover"
      bind:tap="openIssueCodes"
    >
      <view class="capacity-main">
        <text class="ai-row-name">{{copy.issueTitle}}</text>
        <text class="capacity-sub">{{copy.issueSub}}</text>
      </view>
      <text class="ai-row-chevron">›</text>
    </view>

    <view
      wx:if="{{family.isAdmin}}"
      class="ai-row capacity-row"
      hover-class="tool-hover"
      bind:tap="openPlatformKeys"
    >
      <view class="capacity-main">
        <text class="ai-row-name">{{copy.platformTitle}}</text>
        <text class="capacity-sub">{{copy.platformSub}}</text>
      </view>
      <text class="ai-row-chevron">›</text>
    </view>

    <view class="actions-spacer"></view>
    <view class="actions">
      <view
        class="leave-btn theme-btn"
        hover-class="leave-hover"
        bind:tap="onLeave"
      >{{family.isOwner ? copy.leaveOwner : copy.leaveMember}}</view>
    </view>
  </block>
</AppShell>

<view
  class="issue-mask"
  wx:if="{{showIssueForm}}"
  style="--theme-primary: {{theme.primary}}; --theme-secondary: {{theme.secondary}}; --theme-shadow: {{theme.shadow}}; --theme-primary-30: {{theme.primary}}4D;"
  bind:tap="closeIssueForm"
>
  <view class="issue-card" catch:tap="noop">
    <view class="issue-title">{{copy.issueModalTitle}}</view>
    <view class="issue-field">
      <text class="issue-label">{{copy.issueCountLabel}}</text>
      <input
        class="issue-input"
        type="number"
        value="{{issueCount}}"
        maxlength="2"
        placeholder="{{copy.issuePlaceholder}}"
        bindinput="onIssueCountInput"
      />
    </view>
    <view class="issue-field">
      <text class="issue-label">{{copy.issueDurationLabel}}</text>
      <view class="issue-duration-row">
        <input
          class="issue-input issue-input-sm"
          type="number"
          value="{{issueDurationAmount}}"
          maxlength="4"
          placeholder="{{copy.issueDurationPlaceholder}}"
          bindinput="onIssueDurationInput"
        />
        <view class="issue-unit-row">
          <view
            class="issue-unit {{issueDurationUnit === 'day' ? 'on' : ''}}"
            data-unit="day"
            bind:tap="onIssueUnitPick"
          >{{copy.issueUnitDay}}</view>
          <view
            class="issue-unit {{issueDurationUnit === 'week' ? 'on' : ''}}"
            data-unit="week"
            bind:tap="onIssueUnitPick"
          >{{copy.issueUnitWeek}}</view>
          <view
            class="issue-unit {{issueDurationUnit === 'month' ? 'on' : ''}}"
            data-unit="month"
            bind:tap="onIssueUnitPick"
          >{{copy.issueUnitMonth}}</view>
          <view
            class="issue-unit {{issueDurationUnit === 'year' ? 'on' : ''}}"
            data-unit="year"
            bind:tap="onIssueUnitPick"
          >{{copy.issueUnitYear}}</view>
        </view>
      </view>
    </view>
    <view class="issue-error" wx:if="{{issueFormError}}">{{issueFormError}}</view>
    <view class="issue-check {{issueHostedModel ? 'on' : ''}}" bind:tap="onToggleIssueHosted">
      {{copy.issueHostedLabel}}
    </view>
    <view class="issue-actions">
      <view class="issue-btn issue-btn-ghost" bind:tap="closeIssueForm">{{copy.issueCancel}}</view>
      <view class="issue-btn theme-btn {{acting ? 'busy' : ''}}" bind:tap="onIssueCodes">{{copy.issueSubmit}}</view>
    </view>
  </view>
</view>

<view
  class="issue-mask"
  wx:if="{{issuedCodes.length}}"
  style="--theme-primary: {{theme.primary}}; --theme-secondary: {{theme.secondary}}; --theme-shadow: {{theme.shadow}}; --theme-primary-30: {{theme.primary}}4D;"
  bind:tap="closeIssued"
>
  <view class="issue-card" catch:tap="noop">
    <view class="issue-title">{{copy.issueResultTitle}}</view>
    <view class="issue-days" wx:if="{{issuedDaysText}}">{{issuedDaysText}}</view>
    <view class="issue-code" wx:for="{{issuedCodes}}" wx:key="*this">{{item}}</view>
    <view class="issue-copy theme-btn" bind:tap="copyIssued">{{copy.issueCopyAll}}</view>
  </view>
</view>

<view
  class="issue-mask"
  wx:if="{{showPlatformPanel}}"
  style="--theme-primary: {{theme.primary}}; --theme-secondary: {{theme.secondary}}; --theme-shadow: {{theme.shadow}}; --theme-primary-30: {{theme.primary}}4D;"
  bind:tap="closePlatformPanel"
>
  <view class="issue-card platform-card" catch:tap="noop">
    <view class="issue-title">{{copy.platformModalTitle}}</view>
    <picker mode="selector" range="{{platformProviderNames}}" value="{{platformProviderIndex}}" bindchange="onPlatformProviderChange">
      <view class="issue-input picker">{{platformProviderNames[platformProviderIndex] || '选择平台'}}</view>
    </picker>
    <picker
      wx:if="{{platformModelNames.length > 1}}"
      mode="selector"
      range="{{platformModelNames}}"
      value="{{platformModelIndex}}"
      bindchange="onPlatformModelChange"
    >
      <view class="issue-input picker">{{platformModelNames[platformModelIndex]}}</view>
    </picker>
    <view class="issue-input model-line" wx:else>{{platformModelNames[platformModelIndex] || ''}}</view>
    <input class="issue-input" password placeholder="{{copy.platformKeyPlaceholder}}" value="{{platformApiKey}}" bindinput="onPlatformKeyInput" />
    <input class="issue-input" placeholder="{{copy.platformLabelPlaceholder}}" value="{{platformLabel}}" maxlength="20" bindinput="onPlatformLabelInput" />
    <view class="issue-error" wx:if="{{platformError}}">{{platformError}}</view>
    <view class="issue-actions">
      <view class="issue-btn issue-btn-ghost" bind:tap="closePlatformPanel">{{copy.issueCancel}}</view>
      <view class="issue-btn theme-btn {{acting ? 'busy' : ''}}" bind:tap="onAddPlatformKey">{{copy.platformAdd}}</view>
    </view>
    <view class="platform-empty" wx:if="{{!platformKeys.length}}">{{copy.platformEmpty}}</view>
    <view class="platform-row" wx:for="{{platformKeys}}" wx:key="_id">
      <view class="platform-main">
        <view class="platform-name">{{item.label}}<text wx:if="{{!item.enabled}}"> · 已停用</text></view>
        <view class="platform-hint">{{item.providerLabel}} · {{item.model}} · {{item.apiKeyMasked}}</view>
      </view>
      <view class="platform-actions">
        <view class="text-link" data-id="{{item._id}}" data-direction="up" bind:tap="onMovePlatformKey">{{copy.platformUp}}</view>
        <view class="text-link" data-id="{{item._id}}" data-direction="down" bind:tap="onMovePlatformKey">{{copy.platformDown}}</view>
        <view class="text-link" data-id="{{item._id}}" data-enabled="{{item.enabled}}" bind:tap="onTogglePlatformKey">{{item.enabled ? copy.platformDisable : copy.platformEnable}}</view>
        <view class="text-link danger" data-id="{{item._id}}" bind:tap="onRemovePlatformKey">{{copy.platformRemove}}</view>
      </view>
    </view>
  </view>
</view>

<PromptDialog
  show="{{showModal}}"
  title="{{modalTitle}}"
  placeholder="{{modalPlaceholder}}"
  value="{{modalValue}}"
  maxlength="{{modalMaxlength}}"
  error="{{modalError}}"
  cancelText="{{common.cancel}}"
  confirmText="{{modalConfirm}}"
  busy="{{acting}}"
  bind:input="onModalInput"
  bind:confirm="onSaveModal"
  bind:cancel="closeModal"
/>

<page-container
  show="{{sheetShow}}"
  position="bottom"
  round="{{true}}"
  overlay="{{true}}"
  z-index="100"
  overlay-style="background: rgba(20, 16, 12, 0.28);"
  custom-style="height: {{sheetHeight}}; background: #ffffff;"
  bind:clickoverlay="closeSheet"
  bind:beforeleave="closeSheet"
>
  <view class="sheet" wx:if="{{sheetKind === 'mood'}}" style="{{theme.cssVarStyle}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.wallTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="label">{{copy.themePick}}</view>
      <view class="preset-row">
        <view
          class="preset-chip {{theme && theme.id === item.id ? 'on' : ''}}"
          wx:for="{{themes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bind:tap="onPickTheme"
        >
          <view class="preset-chip-bg">
            <ThemeRadialBg
              primary="{{item.primary}}"
              secondary="{{item.secondary}}"
              shadow="{{item.shadow}}"
            />
          </view>
          <text class="preset-label">{{item.label}}</text>
          <view
            class="preset-check"
            wx:if="{{theme && theme.id === item.id}}"
            style="color: {{theme.primary}};"
            aria-hidden="true"
          ></view>
        </view>
      </view>
      <view class="sheet-pad"></view>
    </scroll-view>
  </view>

  <view class="sheet" wx:elif="{{sheetKind === 'members'}}" style="{{theme.cssVarStyle}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.membersTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="members-empty" wx:if="{{!members.length}}">{{copy.membersEmpty}}</view>
      <view
        class="member-list-row {{item.isMe ? 'me' : ''}}"
        wx:for="{{members}}"
        wx:key="openid"
      >
        <view class="member-list-avatar-wrap">
          <image
            wx:if="{{item.avatarUrl}}"
            class="member-list-avatar"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
          <view
            wx:else
            class="member-list-avatar placeholder"
            style="background: {{theme.secondary}};"
          >
            <text class="member-initial sm">{{item.initial}}</text>
          </view>
        </view>
        <view class="member-list-body">
          <view class="member-list-name">{{item.displayName}}</view>
          <view class="member-list-meta" wx:if="{{item.isOwner || item.isMe}}">
            <text wx:if="{{item.isOwner}}">{{copy.ownerBadge}}</text>
            <text wx:if="{{item.isOwner && item.isMe}}"> · </text>
            <text wx:if="{{item.isMe}}">{{copy.meBadge}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-pad"></view>
    </scroll-view>
  </view>

  <view class="sheet" wx:elif="{{sheetKind === 'profile'}}" style="{{theme.cssVarStyle}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.profileSheetTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <view class="profile-body">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{profileDraftAvatar}}"
          class="profile-avatar"
          src="{{profileDraftAvatar}}"
          mode="aspectFill"
        />
        <view
          wx:else
          class="profile-avatar placeholder"
          style="background: {{theme.secondary}};"
        >
          <text class="member-initial">{{profileDraftInitial}}</text>
        </view>
      </button>
      <view class="profile-avatar-hint">{{copy.profileAvatarHint}}</view>
      <view class="profile-label">{{copy.profileNickLabel}}</view>
      <input
        class="profile-input"
        type="nickname"
        maxlength="20"
        value="{{profileDraftNickname}}"
        placeholder="{{copy.profileNickPlaceholder}}"
        bindinput="onProfileNickInput"
        bindblur="onProfileNickBlur"
      />
      <view
        class="profile-save theme-btn"
        hover-class="press"
        bind:tap="onSaveProfile"
      >{{copy.profileSave}}</view>
    </view>
  </view>

  <view class="sheet" wx:elif="{{sheetKind === 'reminder'}}" style="{{theme.cssVarStyle}}">
    <view class="sheet-hd">
      <view class="sheet-title">{{copy.reminderTitle}}</view>
      <view class="sheet-close" bind:tap="closeSheet">×</view>
    </view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="reminder-row">
        <view class="reminder-main">
          <view class="reminder-name">{{copy.reminderSwitchLabel}}</view>
          <view class="reminder-hint">{{copy.reminderSwitchHint}}</view>
        </view>
        <switch
          checked="{{reminderDraft.enabled}}"
          color="{{theme.themeColor}}"
          disabled="{{acting}}"
          bindchange="onReminderToggle"
        />
      </view>

      <view class="label reminder-label">{{copy.reminderTimeline}}</view>
      <view class="reminder-chips">
        <view
          wx:for="{{reminderDayOptions}}"
          wx:key="value"
          class="reminder-chip {{reminderDraft.days === item.value ? 'on' : ''}} {{reminderDraft.enabled ? '' : 'off'}}"
          data-days="{{item.value}}"
          bind:tap="onPickReminderDays"
        >{{item.label}}</view>
      </view>

      <view class="reminder-row">
        <view class="reminder-main">
          <view class="reminder-name">{{copy.reminderSendAt}}</view>
          <view class="reminder-hint">{{copy.reminderSendAtHint}}</view>
        </view>
        <picker
          mode="time"
          value="{{reminderTime}}"
          disabled="{{!reminderDraft.enabled || acting}}"
          bindchange="onPickReminderTime"
        >
          <view class="reminder-time {{reminderDraft.enabled ? '' : 'off'}}">{{reminderTime}}</view>
        </picker>
      </view>

      <view class="reminder-note">{{copy.reminderOnceHint}}</view>
      <view class="sheet-pad"></view>
    </scroll-view>
    <view class="sheet-actions">
      <view
        class="reminder-save theme-btn {{acting ? 'busy' : ''}}"
        hover-class="press"
        bind:tap="saveReminder"
      >{{copy.reminderSave}}</view>
    </view>
  </view>
</page-container>
