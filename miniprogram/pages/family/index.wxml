<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  bgStyle="{{theme.bgStyle}}"
  bgImage="{{theme.bgImage}}"
  lightHeader="{{theme.lightHeader}}"
  themeColor="{{theme.themeColor}}"
>
  <view class="state" wx:if="{{loading}}">
    <view class="state-text">{{copy.loading}}</view>
  </view>

  <view class="state" wx:elif="{{error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <block wx:elif="{{family}}">
    <view class="home-hero">
      <view class="home-kicker">{{copy.nowHere}}</view>
      <view class="home-name">{{family.name}}</view>
      <view class="home-meta">{{familyMeta}}</view>
    </view>

    <view class="sticky">
      <view class="sticky-label">{{copy.inviteLabel}}</view>
      <view class="sticky-row">
        <view class="sticky-code">{{family.inviteCode}}</view>
        <view class="sticky-copy" style="color: {{theme.themeColor}};" bind:tap="onCopyCode">复制</view>
      </view>
      <view class="sticky-hint">{{copy.inviteHint}}</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}" bind:tap="goSpaces">
      <view class="block-hd">
        <view class="block-title">{{copy.spacesTitle}}</view>
        <view class="block-action" style="color: {{theme.themeColor}};">{{copy.spacesAction}}</view>
      </view>
      <view class="block-sub">{{copy.spacesSub}}</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="block-hd">
        <view class="block-title">{{copy.wallTitle}}</view>
        <view
          class="block-action"
          style="color: {{theme.themeColor}};"
          wx:if="{{panel !== 'background'}}"
          bind:tap="openPanel"
          data-panel="background"
        >{{copy.wallAction}}</view>
        <view
          class="block-action"
          style="color: {{theme.themeColor}};"
          wx:else
          bind:tap="closePanel"
        >{{copy.collapse}}</view>
      </view>
      <view class="block-sub">{{copy.wallSub}}</view>

      <view class="mood-panel" wx:if="{{panel === 'background'}}">
        <view class="label">{{copy.gradient}}</view>
        <view class="preset-row">
          <view
            class="preset-chip"
            wx:for="{{gradients}}"
            wx:key="id"
            style="background: {{item.value}};"
            data-value="{{item.value}}"
            bind:tap="onPickGradient"
          >
            <text class="preset-label">{{item.label}}</text>
          </view>
        </view>
        <view class="label spaced">{{copy.solid}}</view>
        <view class="preset-row">
          <view
            class="preset-dot"
            wx:for="{{solids}}"
            wx:key="id"
            style="background: {{item.value}};"
            data-value="{{item.value}}"
            bind:tap="onPickSolid"
          />
        </view>
        <view class="label spaced">照片</view>
        <view
          class="photo-upload"
          style="color: {{theme.themeColor}}; border-color: {{theme.themeColor}};"
          hover-class="photo-upload-hover"
          bind:tap="onPickImage"
        >
          <view class="photo-upload-title">{{copy.pickPhoto}}</view>
          <view class="photo-upload-hint">{{copy.pickPhotoHint}}</view>
        </view>
      </view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="block-hd">
        <view class="block-title">{{copy.myHomes}}</view>
      </view>
      <view class="chip-row">
        <view
          class="chip {{item.isCurrent ? 'on' : ''}}"
          wx:for="{{families}}"
          wx:key="_id"
          style="color: {{item.isCurrent ? theme.themeColor : '#1a1a1a'}};"
          data-id="{{item._id}}"
          bind:tap="onSwitchFamily"
        >
          <view class="chip-name">{{item.name}}</view>
          <view class="chip-meta">{{item.isCurrent ? copy.chipHere : copy.chipGo}} · {{item.memberCount}} 人</view>
        </view>
      </view>
      <view class="action-row">
        <view class="text-btn" style="color: {{theme.themeColor}};" bind:tap="openPanel" data-panel="create">{{copy.createAnother}}</view>
        <view class="text-btn" style="color: {{theme.themeColor}};" bind:tap="openPanel" data-panel="join">{{copy.joinAnother}}</view>
      </view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{panel === 'create'}}">
      <view class="label">{{copy.createNameLabel}}</view>
      <input
        class="input"
        placeholder="{{copy.createNamePlaceholder}}"
        value="{{familyNameInput}}"
        bindinput="onNameInput"
        maxlength="20"
      />
      <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onCreate">{{copy.createSubmit}}</view>
      <view class="text-btn muted" bind:tap="closePanel">{{copy.dismissPanel}}</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{panel === 'join'}}">
      <view class="label">{{copy.joinCodeLabel}}</view>
      <input
        class="input"
        placeholder="{{copy.joinCodePlaceholder}}"
        value="{{inviteCode}}"
        bindinput="onCodeInput"
        maxlength="6"
      />
      <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onJoin">{{copy.joinSubmit}}</view>
      <view class="text-btn muted" bind:tap="closePanel">{{copy.dismissPanel}}</view>
    </view>

    <view class="leave {{theme.isPhoto ? 'on-photo' : ''}}" bind:tap="onLeave">
      {{family.isOwner ? copy.leaveOwner : copy.leaveMember}}
    </view>
  </block>
</AppShell>
