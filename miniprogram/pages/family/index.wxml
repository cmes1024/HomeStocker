<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  back="{{true}}"
  bgStyle="{{theme.bgStyle}}"
  bgImage="{{theme.bgImage}}"
  lightHeader="{{theme.lightHeader}}"
  themeColor="{{theme.themeColor}}"
>
  <view class="state" wx:if="{{loading}}">
    <view class="state-text">推开家门…</view>
  </view>

  <view class="state" wx:elif="{{error}}">
    <view class="state-text error">{{error}}</view>
    <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onRetry">再试一次</view>
  </view>

  <block wx:elif="{{family}}">
    <view class="home-hero {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="home-kicker">现在在这家</view>
      <view class="home-name">{{family.name}}</view>
      <view class="home-meta">家里现在 {{family.memberCount}} 人 · 共用一个柜子</view>
    </view>

    <view class="sticky">
      <view class="sticky-label">把门钥匙给家人</view>
      <view class="sticky-row">
        <view class="sticky-code">{{family.inviteCode}}</view>
        <view class="sticky-copy" style="color: {{theme.themeColor}};" bind:tap="onCopyCode">复制</view>
      </view>
      <view class="sticky-hint">把邀请码发给家人，他们就能进来一起记</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="block-hd">
        <view class="block-title">换一面墙</view>
        <view class="block-action" style="color: {{theme.themeColor}};" bind:tap="openPanel" data-panel="background">挑一挑</view>
      </view>
      <view class="block-sub">背景会跟着这个家，走到哪都是同一面墙</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{panel === 'background'}}">
      <view class="label">渐变</view>
      <view class="preset-row">
        <view
          class="preset-chip"
          wx:for="{{gradients}}"
          wx:key="id"
          style="background: {{item.value}};"
          data-value="{{item.value}}"
          bind:tap="onPickGradient"
        >
          <text class="preset-label">{{item.label}}</text>
        </view>
      </view>
      <view class="label spaced">纯色</view>
      <view class="preset-row">
        <view
          class="preset-dot"
          wx:for="{{solids}}"
          wx:key="id"
          style="background: {{item.value}};"
          data-value="{{item.value}}"
          bind:tap="onPickSolid"
        />
      </view>
      <view class="text-btn" bind:tap="onPickImage">用一张家里的照片</view>
      <view class="text-btn muted" bind:tap="closePanel">收起</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}">
      <view class="block-hd">
        <view class="block-title">我还在的家</view>
      </view>
      <view class="chip-row">
        <view
          class="chip {{item.isCurrent ? 'on' : ''}}"
          wx:for="{{families}}"
          wx:key="_id"
          style="color: {{item.isCurrent ? theme.themeColor : '#1a1a1a'}};"
          data-id="{{item._id}}"
          bind:tap="onSwitchFamily"
        >
          <view class="chip-name">{{item.name}}</view>
          <view class="chip-meta">{{item.isCurrent ? '正待在这' : '点一下过去'}} · {{item.memberCount}} 人</view>
        </view>
      </view>
      <view class="action-row">
        <view class="text-btn" style="color: {{theme.themeColor}};" bind:tap="openPanel" data-panel="create">再建一个家</view>
        <view class="text-btn" style="color: {{theme.themeColor}};" bind:tap="openPanel" data-panel="join">用邀请码进另一家</view>
      </view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{panel === 'create'}}">
      <view class="label">给新家起个名</view>
      <input
        class="input"
        placeholder="例如：老家、出租屋"
        value="{{familyNameInput}}"
        bindinput="onNameInput"
        maxlength="20"
      />
      <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onCreate">建好并住过去</view>
      <view class="text-btn muted" bind:tap="closePanel">先不算了</view>
    </view>

    <view class="block {{theme.isPhoto ? 'on-photo' : ''}}" wx:if="{{panel === 'join'}}">
      <view class="label">家人给的邀请码</view>
      <input
        class="input"
        placeholder="6 位邀请码"
        value="{{inviteCode}}"
        bindinput="onCodeInput"
        maxlength="6"
      />
      <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
      <view class="pill-btn" style="background: {{theme.themeColor}};" bind:tap="onJoin">进去并住过去</view>
      <view class="text-btn muted" bind:tap="closePanel">先不算了</view>
    </view>

    <view class="leave {{theme.isPhoto ? 'on-photo' : ''}}" bind:tap="onLeave">
      {{family.isOwner ? '解散这个家' : '先离开这家'}}
    </view>
  </block>
</AppShell>
