<view class="composer {{keyboardOpen ? 'keyboard-open' : ''}}">
  <view class="mode {{loading ? 'is-disabled' : ''}}" hover-class="mode-hover" bind:tap="onToggleVoice">
    <image
      class="mode-icon"
      src="{{voiceMode ? keyboardIcon : voiceIcon}}"
      mode="aspectFit"
    />
  </view>
  <view
    wx:if="{{voiceMode}}"
    class="hold {{loading ? 'is-disabled' : ''}}"
    hover-class="none"
    catchtouchstart="onHoldStart"
    catchtouchmove="onHoldMove"
    catchtouchend="onHoldEnd"
    catchtouchcancel="onHoldCancel"
  >{{copy.voiceHold}}</view>
  <textarea
    wx:elif="{{fieldOn}}"
    class="input"
    style="height: {{inputHeight}}px;"
    value="{{value}}"
    placeholder="{{placeholder}}"
    placeholder-class="input-placeholder"
    maxlength="{{maxlength}}"
    confirm-type="send"
    show-confirm-bar="{{false}}"
    hold-keyboard="{{true}}"
    adjust-position="{{false}}"
    cursor-spacing="24"
    disable-default-padding="{{true}}"
    disabled="{{loading}}"
    bindinput="onTextInput"
    bindlinechange="onInputLineChange"
    bindconfirm="onConfirm"
    bindblur="onBlur"
    bindkeyboardheightchange="onKeyboardHeightChange"
  />
  <view
    wx:if="{{!voiceMode && value}}"
    class="send theme-btn {{loading ? 'is-disabled' : ''}}"
    bind:tap="onSendTap"
  >{{loading ? sendingLabel : sendLabel}}</view>
  <view class="voice-pop {{recording ? 'is-show' : ''}}">
    <view class="voice-panel {{voiceCancel ? 'is-cancel' : ''}}">
      <view class="voice-bars">
        <view
          wx:for="{{voiceBars}}"
          wx:key="*this"
          class="voice-bar"
          style="animation-delay: {{item * 0.12}}s;"
        ></view>
      </view>
      <view class="voice-hint">{{voiceCancel ? copy.voiceSlideCancel : copy.voiceSlideHint}}</view>
    </view>
  </view>
</view>
