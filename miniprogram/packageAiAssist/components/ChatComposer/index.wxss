.composer {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  margin: 0 -32rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.composer.keyboard-open {
  padding-bottom: 16rpx;
}

.mode {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode.is-disabled {
  opacity: 0.45;
}

.mode-hover {
  opacity: 0.55;
}

.mode-icon {
  width: 48rpx;
  height: 48rpx;
}

.hold {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 26, 0.04);
  text-align: center;
  line-height: 72rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  user-select: none;
}

.hold.is-holding {
  background: rgba(26, 26, 26, 0.14);
}

.hold.is-disabled {
  opacity: 0.45;
}

.voice-pop {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  z-index: 80;
  pointer-events: none;
}

.voice-panel {
  padding: 28rpx 0 22rpx;
  background: #f4f6f8;
  box-shadow: 0 -12rpx 32rpx rgba(26, 26, 26, 0.06);
  box-sizing: border-box;
}

.voice-panel.is-cancel {
  background: #fff1f0;
}

.voice-bars {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.voice-bar {
  width: 4rpx;
  min-height: 6rpx;
  border-radius: 4rpx;
  background: var(--theme-primary, #c4a484);
  flex-shrink: 0;
  transition: height 100ms linear, background 160ms ease;
}

.voice-panel.is-cancel .voice-bar {
  background: #fa5151;
}

.voice-hint {
  margin-top: 16rpx;
  color: rgba(26, 26, 26, 0.45);
  font-size: 26rpx;
  line-height: 1.4;
  text-align: center;
}

.voice-panel.is-cancel .voice-hint {
  color: #fa5151;
}

.input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 232rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 26, 0.04);
  font-size: 28rpx;
  line-height: 40rpx;
  color: #1a1a1a;
  box-sizing: border-box;
  overflow-y: auto;
}

.input-placeholder {
  color: rgba(26, 26, 26, 0.35);
  font-size: 28rpx;
  line-height: 40rpx;
}

.send {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  min-width: 112rpx;
  text-align: center;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.send.is-disabled {
  opacity: 0.45;
}
