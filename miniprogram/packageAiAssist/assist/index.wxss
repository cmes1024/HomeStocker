.chat {
  height: calc(100vh - var(--shell-top, 176rpx));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.focus {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-shrink: 0;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
}

.focus-kicker {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
}

.focus-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
}

.banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a1a;
}

.chat-tools {
  display: flex;
  justify-content: flex-end;
  flex-shrink: 0;
  padding: 0 4rpx 8rpx;
}

.clear-chat {
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: rgba(26, 26, 26, 0.42);
}

.speak-toggle {
  margin-right: 8rpx;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: rgba(26, 26, 26, 0.42);
}

.speak-toggle.is-on {
  color: var(--theme-primary);
  font-weight: 500;
}

/* 朗读按钮：低调一点，别和确认/重试抢视线 */
.speak-row {
  display: flex;
  margin-top: 12rpx;
}

.speak-btn {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(26, 26, 26, 0.45);
  border: 1rpx solid rgba(26, 26, 26, 0.14);
  border-radius: 999rpx;
}

.speak-btn.is-playing {
  color: var(--theme-primary);
  border-color: var(--theme-primary);
}

.clear-chat.is-disabled {
  opacity: 0.4;
}

.text-link {
  font-size: 26rpx;
  font-weight: 500;
}

.msg-list {
  flex: 1;
  height: 0;
  min-height: 0;
  margin: 0 0rpx;
  padding: 8rpx 0rpx 12rpx;
  box-sizing: border-box;
}

.history-cap {
  margin: 0 8rpx 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(26, 26, 26, 0.45);
  text-align: center;
  background: rgba(255, 255, 255, 0.55);
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  max-width: 84%;
  min-width: 0;
  box-sizing: border-box;
}

.msg-user {
  margin-left: auto;
  align-items: flex-end;
}

.msg-assistant {
  width: 84%;
  margin-right: auto;
  align-items: stretch;
}

.bubble {
  max-width: 100%;
  min-width: 0;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
  box-sizing: border-box;
}

.msg-time {
  margin-top: 6rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: rgba(26, 26, 26, 0.4);
}

.msg-user .bubble {
  color: #fff;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
  border-top-right-radius: 8rpx;
}

.msg-user .msg-time {
  align-self: flex-end;
}

.msg-assistant .bubble {
  width: 100%;
  color: #1a1a1a;
  background: rgba(255, 255, 255, 0.96);
  border-top-left-radius: 8rpx;
}

.bubble-pending {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.pending-dots {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  height: 28rpx;
  margin-left: 10rpx;
}

.pending-dot {
  width: 8rpx;
  height: 8rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--theme-primary);
  opacity: 0.3;
  animation: pending-dot 1.05s infinite ease-in-out;
}

.pending-dot:first-child {
  margin-left: 0;
}

.pending-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.pending-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes pending-dot {
  0%,
  70%,
  100% {
    transform: translateY(0);
    opacity: 0.3;
  }
  35% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.msg-assistant .msg-time {
  align-self: flex-start;
}

.blocks {
  width: 100%;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.block {
  width: 100%;
  margin-top: 12rpx;
  padding: 8rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  overflow: hidden;
}

.block:first-child {
  margin-top: 0;
}

.block-title {
  padding: 12rpx 20rpx 4rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
}

.block-title.tone-warn {
  color: #c47a1a;
}

.block-title.tone-error {
  color: #c44;
}

.block-title.tone-ok {
  color: rgba(26, 26, 26, 0.45);
}

.card {
  position: relative;
  padding: 16rpx 20rpx 16rpx 28rpx;
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
  box-sizing: border-box;
}

.card:first-of-type {
  border-top: none;
}

.card::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: rgba(26, 26, 26, 0.12);
}

.card.tone-ok::before {
  background: var(--theme-primary, #c4a484);
}

.card.tone-warn::before {
  background: #e0a045;
}

.card.tone-error::before {
  background: #e05555;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
}

.card-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1.4;
}

.card-facts {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-top: 8rpx;
}

.card-fact {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.4;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.card-tag {
  font-size: 20rpx;
  color: rgba(26, 26, 26, 0.5);
  background: rgba(26, 26, 26, 0.04);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.block-footer {
  padding: 8rpx 20rpx 14rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.4);
}

.ask-block,
.confirm-block,
.fallback {
  width: 100%;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.ask-item + .ask-item {
  margin-top: 16rpx;
}

.ask-q {
  font-size: 26rpx;
  color: #1a1a1a;
  line-height: 1.45;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border-width: 2rpx;
  font-size: 24rpx;
  background: #ffffff;
}

.confirm-hint {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  margin-bottom: 8rpx;
}

.habit-applied {
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(26, 26, 26, 0.55);
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  align-self: flex-start;
  max-width: 100%;
}

.confirm-name {
  font-size: 28rpx;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.confirm-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ghost-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  background: rgba(26, 26, 26, 0.04);
}

.sub-block {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
}

.sub-hint {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(26, 26, 26, 0.45);
}

.sub-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
}

.sub-row:first-of-type {
  border-top: none;
  padding-top: 4rpx;
}

.sub-main {
  flex: 1;
  min-width: 0;
}

.sub-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.sub-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
}

.pill-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.fallback-text {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.55);
  margin-bottom: 8rpx;
}

.retry {
  margin-top: 12rpx;
}

.nav-links {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 12rpx;
}

.nav-link {
  padding: 4rpx 0;
}

.msg-tail {
  height: 8rpx;
}

.state {
  text-align: center;
  padding: 96rpx 32rpx;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.55);
}

.state-text.error {
  color: #fa5151;
  margin-bottom: 32rpx;
}

.present {
  margin-top: 8rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.present-title {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.present-table {
  width: 100%;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(26, 26, 26, 0.08);
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.present-tr {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.present-tr:last-child {
  border-bottom: none;
}

.present-th {
  background: rgba(26, 26, 26, 0.04);
}

.present-td {
  flex: 1;
  min-width: 140rpx;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #1a1a1a;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
}

.present-th .present-td {
  font-weight: 500;
  color: rgba(26, 26, 26, 0.65);
}

.present-footer {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.45);
}

.present-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.present-stat {
  flex: 1;
  min-width: 160rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 26, 0.03);
  box-sizing: border-box;
}

.present-stat-value {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--theme-primary, #c4a484);
}

.present-stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.55);
}

.present-bars {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.present-bar-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.present-bar-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.present-bar-label-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.present-swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.present-bar-label {
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.present-bar-nums {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-shrink: 0;
}

.present-bar-value {
  color: rgba(26, 26, 26, 0.7);
  font-weight: 500;
}

.present-bar-share {
  color: rgba(26, 26, 26, 0.42);
  font-size: 22rpx;
}

.present-bar-track {
  height: 20rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 26, 0.06);
  overflow: hidden;
}

.present-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  min-width: 0;
}

.present-pie {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

.present-pie-chart-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  align-self: center;
  flex-shrink: 0;
}

.present-pie-chart {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.present-pie-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
}

.present-pie-legend {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.present-pie-legend-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  line-height: 1.3;
}

.present-pie-legend-label {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.present-pie-legend-value {
  color: rgba(26, 26, 26, 0.7);
  font-weight: 500;
  flex-shrink: 0;
}

.present-pie-legend-share {
  width: 64rpx;
  text-align: right;
  color: rgba(26, 26, 26, 0.42);
  font-size: 22rpx;
  flex-shrink: 0;
}
