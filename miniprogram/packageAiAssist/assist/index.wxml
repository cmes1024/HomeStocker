<AppShell
  wx:if="{{theme}}"
  title="{{headerTitle}}"
  subtitle="{{modelSubtitle}}"
  back="{{true}}"
  plainBack="{{true}}"
  flushBottom="{{true}}"
  primary="{{theme.primary}}"
  secondary="{{theme.secondary}}"
  shadow="{{theme.shadow}}"
  lightHeader="{{theme.lightHeader}}"
>
  <loading
    show="{{booting}}"
    text="{{copy.pageTitle}}"
    glass
    zIndex="{{200}}"
    ballColor="{{loadingColors}}"
  />

  <view class="state" wx:if="{{fatalError}}">
    <view class="state-text error">{{fatalError}}</view>
    <view class="pill-btn theme-btn" bind:tap="onRetry">{{common.retry}}</view>
  </view>

  <view
    class="chat"
    style="padding-bottom: {{keyboardHeight}}px;"
    wx:elif="{{!booting}}"
  >
    <view class="focus" wx:if="{{focusLabel}}">
      <text class="focus-kicker">{{copy.focusLabel}}</text>
      <text class="focus-name">{{focusLabel}}</text>
    </view>

    <view class="banner" wx:if="{{noKey}}">
      <view class="banner-text">{{copy.noKey}}</view>
      <view class="text-link theme-text" bind:tap="goKeys">{{copy.goKeys}}</view>
    </view>

    <view class="chat-tools" wx:if="{{canClear}}">
      <view
        class="clear-chat {{loading ? 'is-disabled' : ''}}"
        bind:tap="onClearChat"
      >{{copy.clearChat}}</view>
    </view>

    <scroll-view
      class="msg-list"
      scroll-y
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollIntoView}}"
      scroll-with-animation
      bindscrolltoupper="onScrollToOldest"
      upper-threshold="40"
    >
      <view class="history-cap" wx:if="{{transcriptCapped}}">{{copy.historyCapTip}}</view>
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="msg msg-{{item.role}}"
      >
        <view class="bubble bubble-pending" wx:if="{{item.kind === 'pending'}}">
          <text class="pending-label">{{copy.sendingLabel}}</text>
          <view class="pending-dots">
            <view class="pending-dot"></view>
            <view class="pending-dot"></view>
            <view class="pending-dot"></view>
          </view>
        </view>
        <view class="bubble" wx:elif="{{item.bubbleText}}">{{item.bubbleText}}</view>
        <view class="bubble" wx:elif="{{!(item.blocks && item.blocks.length) && !item.present && item.text}}">{{item.text}}</view>

        <view class="blocks" wx:if="{{item.blocks && item.blocks.length}}">
          <view
            class="block"
            wx:for="{{item.blocks}}"
            wx:for-item="grp"
            wx:key="key"
          >
            <view
              class="block-title tone-{{grp.tone}}"
              wx:if="{{grp.title}}"
            >{{grp.title}}</view>
            <view
              class="card tone-{{card.tone}}"
              wx:for="{{grp.cards}}"
              wx:for-item="card"
              wx:key="key"
            >
              <view class="card-title">{{card.title}}</view>
              <view class="card-sub" wx:if="{{card.subtitle}}">{{card.subtitle}}</view>
              <view class="card-facts" wx:if="{{card.hasFacts}}">
                <text
                  class="card-fact"
                  wx:for="{{card.facts}}"
                  wx:for-item="fact"
                  wx:key="*this"
                >{{fact}}</text>
              </view>
              <view class="card-tags" wx:if="{{card.hasTags}}">
                <text
                  class="card-tag"
                  wx:for="{{card.tags}}"
                  wx:for-item="tag"
                  wx:key="*this"
                >{{tag}}</text>
              </view>
            </view>
            <view class="block-footer" wx:if="{{grp.footer}}">{{grp.footer}}</view>
          </view>
        </view>

        <view class="present" wx:if="{{item.present}}">
          <view class="present-title" wx:if="{{item.present.title}}">{{item.present.title}}</view>

          <view class="present-table" wx:if="{{item.present.type === 'table'}}">
            <view class="present-tr present-th">
              <view
                class="present-td"
                style="flex: {{item.present.widths[index]}}"
                wx:for="{{item.present.columns}}"
                wx:for-item="col"
                wx:key="*this"
              >{{col}}</view>
            </view>
            <view
              class="present-tr"
              wx:for="{{item.present.rows}}"
              wx:for-item="row"
              wx:key="key"
            >
              <view
                class="present-td"
                style="flex: {{item.present.widths[index]}}"
                wx:for="{{row.cells}}"
                wx:for-item="cell"
                wx:key="*this"
              >{{cell}}</view>
            </view>
          </view>
          <view class="present-caption" wx:if="{{item.present.type === 'table' && item.present.caption}}">{{item.present.caption}}</view>
          <view class="present-footer" wx:if="{{item.present.type === 'table' && item.present.footer}}">{{item.present.footer}}</view>

          <view class="present-stats" wx:if="{{item.present.type === 'stats'}}">
            <view
              class="present-stat"
              wx:for="{{item.present.items}}"
              wx:for-item="it"
              wx:key="key"
            >
              <view class="present-stat-value theme-text">{{it.value}}</view>
              <view class="present-stat-label">{{it.label}}</view>
            </view>
          </view>

          <view class="present-bars" wx:if="{{item.present.type === 'bars'}}">
            <view
              class="present-bar-row"
              wx:for="{{item.present.items}}"
              wx:for-item="it"
              wx:key="key"
            >
              <view class="present-bar-meta">
                <view class="present-bar-label-wrap">
                  <view class="present-swatch" style="background: {{it.color}};"></view>
                  <text class="present-bar-label">{{it.label}}</text>
                </view>
                <view class="present-bar-nums">
                  <text class="present-bar-value">{{it.value}}</text>
                  <text class="present-bar-share" wx:if="{{it.shareLabel}}">{{it.shareLabel}}</text>
                </view>
              </view>
              <view class="present-bar-track">
                <view class="present-bar-fill" style="{{it.fillStyle}}"></view>
              </view>
            </view>
          </view>

          <view class="present-pie" wx:if="{{item.present.type === 'pie'}}">
            <view class="present-pie-chart-wrap">
              <view class="present-pie-chart" style="{{item.present.pieStyle}}"></view>
              <view class="present-pie-hole"></view>
            </view>
            <view class="present-pie-legend">
              <view
                class="present-pie-legend-row"
                wx:for="{{item.present.items}}"
                wx:for-item="it"
                wx:key="key"
              >
                <view class="present-swatch" style="background: {{it.color}};"></view>
                <text class="present-pie-legend-label">{{it.label}}</text>
                <text class="present-pie-legend-value">{{it.value}}</text>
                <text class="present-pie-legend-share" wx:if="{{it.shareLabel}}">{{it.shareLabel}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="msg-time" wx:if="{{item.timeLabel}}">{{item.timeLabel}}</view>

        <view class="ask-block" wx:if="{{item.hasChips}}">
          <view class="chips">
            <block wx:for="{{item.askList}}" wx:for-item="ask" wx:key="question">
              <view
                class="chip theme-border theme-text"
                wx:for="{{ask.options}}"
                wx:for-item="opt"
                wx:key="value"
                data-value="{{opt.value}}"
                data-label="{{opt.label}}"
                bind:tap="onPickChip"
              >{{opt.label}}</view>
            </block>
          </view>
        </view>

        <view class="text-link theme-text retry" wx:if="{{item.goKeys}}" bind:tap="goKeys">{{copy.goKeys}}</view>

        <view class="text-link theme-text retry" wx:if="{{item.goSpaces}}" bind:tap="goSpaces">{{copy.goSpaces}}</view>

        <view class="nav-links" wx:if="{{item.navLinks && item.navLinks.length}}">
          <view
            class="text-link theme-text nav-link"
            wx:for="{{item.navLinks}}"
            wx:for-item="nav"
            wx:key="key"
            data-url="{{nav.url}}"
            bind:tap="onTapNavLink"
          >{{nav.label}}</view>
        </view>

        <view class="confirm-block" wx:if="{{item.confirmList && item.confirmList.length}}">
          <view class="confirm-hint" wx:if="{{item.confirmHint}}">{{item.confirmHint}}</view>
          <view class="confirm-hint" wx:elif="{{item.confirmKind === 'batch'}}">{{copy.confirmBatchHint}}</view>
          <view class="confirm-hint" wx:elif="{{item.confirmKind === 'merge'}}">{{copy.confirmMergeHint}}</view>
          <view class="confirm-hint" wx:elif="{{item.confirmKind === 'removeUpdated'}}">{{copy.confirmHintUpdated}}</view>
          <view class="confirm-hint" wx:else>{{copy.confirmHint}}</view>
          <view class="confirm-name" wx:for="{{item.confirmList}}" wx:for-item="row" wx:key="key">
            {{row.displayName}}
          </view>
          <view class="confirm-actions">
            <view class="ghost-btn" bind:tap="onCancelConfirm">{{copy.confirmNo}}</view>
            <view class="pill-btn theme-btn" bind:tap="onConfirmRemove">{{item.confirmKind === 'merge' ? copy.confirmMergeYes : (item.confirmKind === 'batch' ? copy.confirmBatchYes : copy.confirmYes)}}</view>
          </view>
        </view>

        <view class="sub-block" wx:if="{{item.subscribeItems && item.subscribeItems.length}}">
          <view class="sub-hint">{{copy.subscribeHint}}</view>
          <view
            class="sub-row"
            wx:for="{{item.subscribeItems}}"
            wx:for-item="sub"
            wx:key="itemId"
          >
            <view class="sub-main">
              <view class="sub-name">{{sub.name}}</view>
              <view class="sub-meta">
                <text wx:if="{{sub.expireDate}}">过期 {{sub.expireDate}}</text>
                <text wx:if="{{sub.placeLabel}}"> · {{sub.placeLabel}}</text>
              </view>
            </view>
            <switch
              checked="{{sub.expireReminderEnabled}}"
              color="{{theme.themeColor}}"
              data-msgid="{{item.id}}"
              data-itemid="{{sub.itemId}}"
              bindchange="onToggleSubscribe"
            />
          </view>
        </view>

        <view class="fallback" wx:if="{{item.showEdit}}">
          <view class="fallback-text">{{copy.needEdit}}</view>
          <view class="text-link theme-text" bind:tap="goEdit">{{copy.goEdit}}</view>
        </view>

        <view class="text-link theme-text retry" wx:if="{{item.retry}}" bind:tap="onRetry">{{common.retry}}</view>
      </view>
      <view id="msg-bottom" class="msg-tail"></view>
    </scroll-view>

    <ChatComposer
      value="{{text}}"
      theme-color="{{theme.themeColor}}"
      loading="{{loading}}"
      placeholder="{{copy.placeholder}}"
      send-label="{{copy.send}}"
      sending-label="{{copy.sendingShort}}"
      bind:input="onTextInput"
      bind:send="onSend"
      bind:keyboardheight="onKeyboardHeightChange"
      bind:blur="onComposerBlur"
    />
  </view>
</AppShell>
