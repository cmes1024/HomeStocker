.page {
  padding-bottom: 160rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 4rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}

.card-hd {
  padding: 26rpx 0 6rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.06);
}

.row-last,
.row:last-child {
  border-bottom: none;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
}

.row-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.45;
  word-break: break-all;
}

.row-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.3);
}

.row-flag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--theme-primary);
}

.row-chevron {
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1;
  color: rgba(26, 26, 26, 0.25);
}

.row-note {
  padding: 24rpx 0 28rpx;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.55;
}

.note {
  margin: 4rpx 8rpx 0;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.6;
}

.note.error-text {
  color: #fa5151;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.save-btn {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.save-btn.busy {
  opacity: 0.6;
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: rgba(26, 26, 26, 0.65);
  margin-bottom: 24rpx;
}

.state-text.error {
  color: #fa5151;
}

.pill-btn {
  height: 70rpx;
  display: inline-block;
  padding: 0 40rpx;
  border-radius: 999rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.press {
  opacity: 0.6;
}
