.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(26, 26, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.panel {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.45;
  text-align: center;
}

.sub-em {
  color: #1a1a1a;
}

.image-picker {
  position: relative;
  margin-top: 24rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f6f4f1;
}

.image-hit {
  width: 100%;
  height: 100%;
}

.image-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.image-empty {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 2rpx dashed var(--theme-secondary);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.image-plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--theme-primary);
}

.image-hint {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.38);
}

.image-replace {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 26, 0.48);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 44rpx;
}

.image-clear {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(26, 26, 26, 0.48);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
}

.field {
  margin-top: 40rpx;
  width: 100%;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--theme-secondary);
  background: #ffffff;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1a1a1a;
}

.error {
  color: var(--error-color, #fa5151);
  font-size: 24rpx;
  margin: 12rpx 0 0;
  text-align: center;
}

.actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 54rpx;
}

.btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.btn.ghost {
  color: var(--theme-primary);
  background: #ffffff;
  border: 2rpx solid var(--theme-primary);
}

.btn.primary {
  color: #ffffff;
  border: none;
  background: linear-gradient(
    90deg,
    var(--theme-primary) 0%,
    var(--theme-secondary) 100%
  );
}
