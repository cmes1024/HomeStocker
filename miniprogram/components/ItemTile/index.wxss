.tile {
  position: relative;
  width: 100%;
  height: 156rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.tile-photo-clip {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  border-radius: inherit;
}

.tile-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.tile-frost {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.7);
}

.tile::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 20rpx 0 var(--theme-shadow);
  pointer-events: none;
  z-index: 0;
}

.tile.anim {
  animation: tile-in 0.42s ease both;
}

.tile.has-place {
  height: auto;
  min-height: 0;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--theme-shadow);
  justify-content: flex-start;
  gap: 12rpx;
}

.tile.has-place::before {
  display: none;
}

.tile.selected {
  box-shadow: inset 0 0 0 3rpx var(--theme-primary);
}

.tile.selected::before {
  box-shadow: 0 6rpx 20rpx 0 var(--theme-shadow);
}

.tile-check {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-check-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 3rpx solid rgba(26, 26, 26, 0.28);
  background: #ffffff;
}

.tile-check-dot.on {
  border-color: var(--theme-primary);
  background: var(--theme-primary);
  box-shadow: inset 0 0 0 5rpx #ffffff;
}

.tile-hover {
  opacity: 0.72;
}

.tile-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.tile-name {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-qty-inline {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tile-qty-x {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--theme-primary);
}

.tile-place {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.38);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-qty-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx 8rpx;
  min-width: 0;
}

.tile-qty {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--theme-primary);
}

.tile-unit {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.55);
  line-height: 1;
}

.badge {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
  line-height: 1.4;
}

.badge.expired {
  color: #e85d5d;
  background: rgba(250, 81, 81, 0.14);
}

.badge.expiring {
  color: #e09a3e;
  background: rgba(224, 154, 62, 0.16);
}

@keyframes tile-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
