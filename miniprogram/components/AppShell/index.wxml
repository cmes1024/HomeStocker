<view
  class="shell"
  style="--theme-primary: {{primary}}; --theme-secondary: {{secondary}}; --theme-shadow: {{shadow}}; --theme-primary-30: {{primary}}4D;"
>
  <view class="bg-layer {{layerA.bgImage ? 'has-image' : ''}}" style="opacity: {{layerA.opacity}};">
    <image wx:if="{{layerA.bgImage}}" class="bg-image" src="{{layerA.bgImage}}" mode="aspectFill" />
    <ThemeRadialBg
      wx:else
      primary="{{layerA.primary}}"
      secondary="{{layerA.secondary}}"
      shadow="{{layerA.shadow}}"
    />
    <view wx:if="{{layerA.bgImage}}" class="bg-veil frost"></view>
  </view>
  <view class="bg-layer {{layerB.bgImage ? 'has-image' : ''}}" style="opacity: {{layerB.opacity}};">
    <image wx:if="{{layerB.bgImage}}" class="bg-image" src="{{layerB.bgImage}}" mode="aspectFill" />
    <ThemeRadialBg
      wx:else
      primary="{{layerB.primary}}"
      secondary="{{layerB.secondary}}"
      shadow="{{layerB.shadow}}"
    />
    <view wx:if="{{layerB.bgImage}}" class="bg-veil frost"></view>
  </view>

  <view class="nav {{navLight ? 'light' : 'dark'}}" style="height: {{headerHeight}}px;">
    <view
      class="nav-inner"
      style="margin-top: {{navContentTop}}px; height: {{navContentHeight}}px; padding-right: {{navSideWidth}}px;"
    >
      <view wx:if="{{back}}" class="nav-back {{plainBack ? 'plain' : ''}}" bind:tap="onBack">
        <view wx:if="{{plainBack}}" class="nav-chevron"></view>
        <text wx:else>返回</text>
      </view>
      <view wx:elif="{{centerTitle}}" class="nav-slot">
        <slot name="nav-left"></slot>
      </view>
      <view wx:else class="nav-back spacer"></view>
      <view wx:if="{{!centerTitle && !plainBack}}" class="nav-title">{{title}}</view>
    </view>
    <view
      wx:if="{{centerTitle || plainBack}}"
      class="nav-title-float {{plainBack ? 'plain' : ''}}"
      style="top: {{navContentTop}}px; height: {{navContentHeight + subtitleExtra}}px;{{plainBack ? 'padding-left:' + navSideWidth + 'px;padding-right:' + navSideWidth + 'px;' : ''}}"
    >
      <view class="nav-title-stack">
        <text class="nav-title-text">{{title}}</text>
        <text wx:if="{{subtitle}}" class="nav-subtitle">{{subtitle}}</text>
      </view>
    </view>
  </view>

  <view class="body {{flushBottom ? 'flush' : ''}}" style="padding-top: {{headerHeight + 12}}px; --shell-top: {{headerHeight + 12}}px;">
    <slot />
  </view>
</view>
