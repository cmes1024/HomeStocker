<view class="shell" style="--main-color: {{themeColor}};">
  <view
    class="bg-layer"
    style="{{layerA.bgStyle}}; opacity: {{layerA.opacity}};"
  >
    <image wx:if="{{layerA.bgImage}}" class="bg-image" src="{{layerA.bgImage}}" mode="aspectFill" />
    <view
      class="bg-veil {{layerA.bgImage ? 'frost' : (layerA.lightHeader ? 'dark' : 'light')}}"
    ></view>
  </view>
  <view
    class="bg-layer"
    style="{{layerB.bgStyle}}; opacity: {{layerB.opacity}};"
  >
    <image wx:if="{{layerB.bgImage}}" class="bg-image" src="{{layerB.bgImage}}" mode="aspectFill" />
    <view
      class="bg-veil {{layerB.bgImage ? 'frost' : (layerB.lightHeader ? 'dark' : 'light')}}"
    ></view>
  </view>

  <view class="nav {{navLight ? 'light' : 'dark'}}" style="height: {{headerHeight}}px;">
    <view
      class="nav-inner"
      style="margin-top: {{navContentTop}}px; height: {{navContentHeight}}px; padding-right: {{navSideWidth}}px;"
    >
      <view wx:if="{{back}}" class="nav-back" bind:tap="onBack">返回</view>
      <view wx:elif="{{centerTitle}}" class="nav-slot">
        <slot name="nav-left"></slot>
      </view>
      <view wx:else class="nav-back spacer"></view>
      <view wx:if="{{!centerTitle}}" class="nav-title">{{title}}</view>
    </view>
    <view
      wx:if="{{centerTitle}}"
      class="nav-title-float"
      style="top: {{navContentTop}}px; height: {{navContentHeight}}px;"
    >{{title}}</view>
  </view>

  <view class="body {{flushBottom ? 'flush' : ''}}" style="padding-top: {{headerHeight + 12}}px; --shell-top: {{headerHeight + 12}}px;">
    <slot />
  </view>
</view>
