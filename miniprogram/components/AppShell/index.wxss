.shell {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.bg-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  transition: opacity 0.45s ease;
  will-change: opacity;
}

.bg-image {
  width: 100%;
  height: 100%;
  display: block;
  filter: brightness(1.06) contrast(0.92) saturate(0.88);
}

.bg-veil {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.bg-veil.light {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.1) 40%,
    rgba(255, 255, 255, 0.3) 100%
  );
}

.bg-veil.dark {
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.38) 0%,
    rgba(0, 0, 0, 0.22) 45%,
    rgba(0, 0, 0, 0.48) 100%
  );
}

/* 照片背景：整体压一层暖白雾，保证深色字可读，仍透出照片 */
.bg-veil.frost {
  background: linear-gradient(
    180deg,
    rgba(252, 249, 244, 0.82) 0%,
    rgba(252, 249, 244, 0.68) 38%,
    rgba(252, 249, 244, 0.78) 100%
  );
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: transparent;
  box-sizing: border-box;
  transition: color 0.35s ease;
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 12rpx;
  box-sizing: border-box;
}

.nav-back {
  min-width: 88rpx;
  height: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #1a1a1a;
  text-shadow: none;
}

.nav-back.spacer {
  visibility: hidden;
  background: transparent;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 88rpx;
  box-sizing: border-box;
  min-height: 1em;
}

.nav.dark .nav-back,
.nav.dark .nav-title {
  color: #1a1a1a;
}

.nav.light .nav-back {
  background: rgba(0, 0, 0, 0.38);
  color: #fff;
}

.nav.light .nav-title {
  color: #fff;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
}

.body {
  position: relative;
  z-index: 1;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
