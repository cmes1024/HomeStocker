.shell {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--theme-shadow);
}

.bg-layer {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  height: 28.5vh;
  z-index: 0;
  overflow: hidden;
  transition: opacity 0.45s ease;
  will-change: opacity;
  pointer-events: none;
  /* 底部模糊消失，避免 28.5vh 裁切出硬边；全站统一 */
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
  mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
}

/* 空间封面只铺顶部，底部淡出，避免盖住列表 */
.bg-layer.has-image {
  bottom: auto;
  height: 42vh;
}

.bg-image {
  width: 100%;
  height: 100%;
  display: block;
  filter: brightness(1.06) contrast(0.92) saturate(0.88);
}

.bg-veil {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

/* 照片背景：整体压一层暖白雾，保证深色字可读，仍透出照片 */
.bg-veil.frost {
  background: linear-gradient(
    180deg,
    rgba(252, 249, 244, 0.28) 0%,
    rgba(252, 249, 244, 0.18) 38%,
    rgba(252, 249, 244, 0.42) 100%
  );
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: transparent;
  box-sizing: border-box;
  transition: color 0.35s ease;
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.nav-back {
  min-width: 88rpx;
  height: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #1a1a1a;
  text-shadow: none;
}

.nav-back.plain {
  width: 88rpx;
  min-width: 88rpx;
  padding: 0 0 0 12rpx;
  background: transparent;
  border-radius: 0;
  justify-content: flex-start;
}

.nav-back.spacer {
  visibility: hidden;
  background: transparent;
}

.nav-chevron {
  width: 22rpx;
  height: 22rpx;
  margin-left: 4rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.nav.light .nav-back.plain {
  background: transparent;
  color: #fff;
}

.nav-slot {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  align-items: center;
}

.nav-title-float {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  pointer-events: none;
  box-sizing: border-box;
}

.nav-title-float.plain {
  font-size: 34rpx;
  font-weight: 500;
}

.nav-title-stack {
  max-width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.nav-title-text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-subtitle {
  max-width: 100%;
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  opacity: 0.62;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav.dark .nav-title-float {
  color: #1a1a1a;
}

.nav.light .nav-title-float {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 88rpx;
  box-sizing: border-box;
  min-height: 1em;
}

.nav.dark .nav-back,
.nav.dark .nav-title {
  color: #1a1a1a;
}

.nav.light .nav-back {
  background: rgba(0, 0, 0, 0.38);
  color: #fff;
}

.nav.light .nav-title {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

.body {
  position: relative;
  z-index: 1;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.body.flush {
  padding-bottom: 0;
}
