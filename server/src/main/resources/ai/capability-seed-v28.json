[{"id":"item.search","fn":"item","action":"search","enabled":true,"confirm":false,"args":"name?, spaceName?, locationName?","hint":"查当前家庭物资台账（只读）。name 可空：空则按 spaceName/locationName（可都空=全家）列出；有 name 则按名称匹配。不是临期专用。"},{"id":"item.listExpiring","fn":"item","action":"listExpiring","enabled":true,"confirm":false,"args":"","hint":"只读临期/过期子集。空结果仅表示没有临期或过期物资，不代表家里没货；不能代替全库盘点。"},{"id":"item.create","fn":"item","action":"create","enabled":true,"confirm":false,"args":"name, quantity?, unit?, spaceName, locationName?, tagNames?, expireDate?, productionDate?, note?","hint":"新开一条台账，须 spaceName。quantity 为该行数量。本轮须已按名 probe。"},{"id":"item.createMany","fn":"item","action":"createMany","enabled":true,"confirm":false,"args":"items[{ name, quantity?, unit?, spaceName, locationName?, tagNames?, expireDate?, productionDate?, note? }]","hint":"一次新开 2～20 条台账，每条须 spaceName。本轮须已按名 probe。"},{"id":"item.update","fn":"item","action":"update","enabled":true,"confirm":false,"args":"ref, name?, quantity?, unit?, spaceName?, locationName?, tagNames?, expireDate?, productionDate?, note?","hint":"改已有物资。quantity 为改成后的绝对值，须大于 0。用本轮 F*/P*。"},{"id":"item.remove","fn":"item","action":"remove","enabled":true,"confirm":true,"args":"ref","hint":"删除一件物资。执行前须用户确认。"},{"id":"item.removeMany","fn":"item","action":"removeMany","enabled":true,"confirm":true,"args":"refs[]","hint":"一次删除 2～20 件，refs 为本轮短号。执行前须用户确认。"},{"id":"space.create","fn":"space","action":"create","enabled":true,"confirm":false,"args":"name","hint":"新建一个空间。本版不能改已有空间名。"},{"id":"space.createMany","fn":"space","action":"createMany","enabled":true,"confirm":false,"args":"spaces[{ name }]","hint":"一次新建 2～20 个空间。本版不能改名。"},{"id":"space.createLocation","fn":"space","action":"createLocation","enabled":true,"confirm":false,"args":"spaceName, locationName","hint":"在已有空间下新建一个位置，须 spaceName。"},{"id":"space.createLocationMany","fn":"space","action":"createLocationMany","enabled":true,"confirm":false,"args":"locations[{ spaceName, locationName }]","hint":"一次在已有空间下新建 2～20 个位置。"},{"id":"space.remove","fn":"space","action":"remove","enabled":true,"confirm":true,"args":"spaceName","hint":"删除一个空间。执行前须用户确认。默认仓库不能删。"},{"id":"space.removeMany","fn":"space","action":"removeMany","enabled":true,"confirm":true,"args":"spaces[{ name }] 或 names[]","hint":"一次删除 2～20 个空间。执行前须用户确认。默认仓库不能删。"},{"id":"space.removeLocation","fn":"space","action":"removeLocation","enabled":true,"confirm":true,"args":"spaceName, locationName","hint":"删除某个空间下的一个位置。执行前须用户确认。物资留在该空间。"},{"id":"space.removeLocationMany","fn":"space","action":"removeLocationMany","enabled":true,"confirm":true,"args":"locations[{ spaceName, locationName }]","hint":"一次删除 2～20 个位置。执行前须用户确认。物资留在所属空间。"},{"id":"tag.create","fn":"tag","action":"create","enabled":true,"confirm":false,"args":"name","hint":"新建一个家庭级标签名。给物资挂签用 item.update 的 tagNames。"},{"id":"tag.createMany","fn":"tag","action":"createMany","enabled":true,"confirm":false,"args":"tags[{ name }] 或 names[]","hint":"一次新建 2～20 个家庭级标签。给物资挂签用 item.update 的 tagNames。"},{"id":"tag.remove","fn":"tag","action":"remove","enabled":true,"confirm":true,"args":"name","hint":"删除一个家庭级标签。执行前须用户确认。本版不能改标签名。"},{"id":"tag.removeMany","fn":"tag","action":"removeMany","enabled":true,"confirm":true,"args":"names[] 或 tags[{ name }]","hint":"一次删除 2～20 个家庭级标签。执行前须用户确认。本版不能改名。"},{"id":"item.merge","fn":"item","action":"merge","enabled":true,"confirm":true,"args":"refs[], name?","hint":"把多条已有物资合成一条并加总数量。refs 至少两条；同空间、单位须一致。执行前须用户确认。"},{"id":"item.expireSubscribePanel","fn":"ai","action":"expireSubscribePanel","enabled":true,"confirm":false,"args":"","hint":"打开临期消息订阅面板。不能代开微信订阅。"},{"id":"knowledge.get","fn":"ai","action":"knowledgeGet","enabled":true,"confirm":false,"args":"topicId","hint":"按知识目录 topicId 取一篇。一次一个。不要编目录外内容，不要用来写库。"},{"id":"page.get","fn":"ai","action":"pageGet","enabled":true,"confirm":false,"args":"pageId?, query?, open?, label?, ref?","hint":"按需取页面目录或契约。无 pageId 或未知 pageId 返回目录。跳转须 open:true。禁止臆造 path。"},{"id":"space.update","fn":"space","action":"update","enabled":false,"confirm":false,"args":"name","hint":"改空间名。本版关闭。"},{"id":"tag.update","fn":"tag","action":"update","enabled":false,"confirm":false,"args":"name","hint":"改标签名。本版关闭。"}]