# =============================================================================
# HomeStocker API 环境变量（复制为 .env 后填写；勿提交 git）
#   cp .env.example .env
# 改完后：docker compose up -d api --force-recreate
# =============================================================================

# --- 微信小程序登录（code2session）---
# 与微信公众平台「开发 → 开发管理 → 开发设置」里的 AppID / AppSecret 一致。
# 小程序 project.config.json / config/index.js 的 appId 须与 WECHAT_APP_ID 相同。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 是否启用 mock 登录。false=真实 wx.login；true=把 login 的 code 直接当 openid（仅应急）。
WECHAT_MOCK_ENABLED=false

# --- 内测容量 / 兑换相关 ---
# 可在家庭页「发放内测码」的管理员微信 openid（登录后 /api/auth/me 可见）。
# 多个用英文逗号分隔，例如：oXXX111,oYYY222
ADMIN_OPENIDS=

# AI 管家话术里「可添加的微信号」（给人加好友用，如 zhangsan_wx；不是 openid）。
# 用户问怎么拿兑换码且没有码时会引导加此号；留空则只说等官方通知。
CAPACITY_ADMIN_WECHAT=

# 物资临期订阅消息模板 ID（微信公众平台订阅消息模板）。
EXPIRE_SUBSCRIBE_TMPL_ID=_oheW_DGsoqUxKsFIQrWSYIuoo4stYvsJv-JNf_uAiQ

# --- AI ---
# ai.act 每个 openid 每分钟请求上限；0=不限制。
AI_ACT_RATE_PER_MINUTE=30

# --- 对象存储（MinIO）---
# 小程序展示图用的公网基址（上传已走 API，不必把此主机配进 request 合法域名）。
# 模拟器一般用 127.0.0.1；真机改成电脑局域网 IP，如 http://192.168.1.8:9000。
# 生产可与 API 同域反代，或单独图床子域。
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
