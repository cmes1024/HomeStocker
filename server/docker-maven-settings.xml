<?xml version="1.0" encoding="UTF-8"?>
<!-- Used only inside the Docker build (see Dockerfile). Aliyun public mirror
     covers central + spring; keeps server-side builds off flaky direct routes
     to repo.maven.apache.org. Local mvn/IDE builds are unaffected. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
